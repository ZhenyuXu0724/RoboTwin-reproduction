+from XPolicyLab.utils.process_data import pack_robot_state,get_robot_action_dim_info,unpack_robot_state,decode_image_bit
+
+RUN=ROOT/'data/dp_compare_20261007/run2000_v2'
+OUT=RUN/'diagnosis_20261008'
+data=Episodes();info=get_robot_action_dim_info('aloha_agilex')
+source=ROOT/'data/demo_train50_wrist_v2/stack_blocks_two/aloha_agilex/data'
+errors=[];frequencies=[];image_errors=[]
+for ep in range(50):
+    with h5py.File(source/f'episode_{ep:07d}.hdf5') as f:
+        raw={name:{k:v[()] for k,v in f[name].items()} for name in ['state','action']}
+        state=pack_robot_state(raw,'joint',info,source_type='dataset',state_type='state')
+        action=pack_robot_state(raw,'joint',info,source_type='dataset',state_type='action')
+        frequencies.append(int(f['additional_info/frequency'][()]))
+        center=int(data.groups[str(ep)]['red_grasp'][len(data.groups[str(ep)]['red_grasp'])//2])
+        with h5py.File(DATA/f'episode_{ep}.hdf5') as converted:
+            for camera in CAMERAS:
+                rgb=cv2.resize(decode_image_bit(f[f'vision/{camera}/colors'][center]),(640,480))
+                stored=converted[f'observations/images/{camera}'][center]
+                assert rgb.shape==stored.shape
+                image_errors.append(int(np.abs(rgb.astype(int)-stored.astype(int)).max()))
+    errors.append({'episode':ep,'raw_state_conversion_max_error':float(np.abs(state-data.states[ep]).max()),
+        'raw_action_conversion_max_error':float(np.abs(action-data.actions[ep]).max()),
+        'state_vs_action_max_error':float(np.abs(state-action).max()),
+        'action_t_vs_state_tplus1_max_error_excluding_final':float(np.abs(action[:-1]-state[1:]).max())})
+probe=data.actions[0][0:8]
+roundtrip=np.stack([pack_robot_state({'state':x},'joint',info,source_type='obs')
+    for x in unpack_robot_state(probe,'joint',info,source_type='obs')])
+assert np.array_equal(probe,roundtrip)
+closed=[]
+allrows=json.loads((RUN/'FOUR_WAY_COMPARISON.json').read_text())['rows']
+for row in allrows:
+    if row['policy'] not in ['DP','DP_RGBD']:continue
+    path=__import__('pathlib').Path(row.get('result_path',RUN/'evaluation/fresh_test'/f"DP-seed{row['seed']}"/'result.json'))
+    trace=[json.loads(x) for x in (path.parent/'trace.jsonl').read_text().splitlines()]
+    a=np.asarray([x['action'] for x in trace]);events={}
+    for j in (6,13):
+        closed_ids=np.flatnonzero(a[:,j]<=.2)
+        changes=np.flatnonzero((a[1:,j]>.5)!=(a[:-1,j]>.5))+2
+        events[str(j)]={'first_command_le_point2_step':None if not len(closed_ids) else int(closed_ids[0]+1),
+            'binary_crossing_count':len(changes),'binary_crossing_steps':changes.tolist(),
+            'min':float(a[:,j].min()),'max':float(a[:,j].max())}
+    closed.append({'policy':row['policy'],'seed':row['seed'],'success':row['success'],
+        'gripper_commands':events,'prediction_calls':row['prediction_calls'],'steps':row['steps'],
+        'mean_actions_per_prediction':row['steps']/row['prediction_calls'],
+        'cube_mode':('L' if row['initial']['red'][0]<0 else 'R')+('L' if row['initial']['green'][0]<0 else 'R')})
+ck=torch.load(RUN/'training/2000.pt',map_location='cpu',weights_only=False)
+norm=data.normalizer().state_dict()
+normalizer_error=max(float((v-ck['ema']['normalizer.'+k]).abs().max()) for k,v in norm.items())
+result={'status':'completed','raw_conversion_checks':errors,'frequency_metadata_unique':sorted(set(frequencies)),
+    'rgb_checks':len(image_errors),'rgb_conversion_max_pixel_error':max(image_errors),
+    'normalizer_recomputed_max_error':normalizer_error,
+    'pack_unpack_roundtrip_exact':True,'closed_loop_gripper_command_traces':closed,
+    'source_hashes':{p:sha(ROOT/p) for p in ['scripts/dp_comparison/evaluate.py',
+        'scripts/dp_comparison/evaluate_rgbd.py','scripts/eval_policy_xpolicylab.py','envs/_base_task.py',
+        'envs/robot/robot.py','XPolicyLab/policy/ACT/detr/process_data.py',
+        'XPolicyLab/policy/DP/diffusion_policy/policy/diffusion_unet_image_policy.py','envs/utils/pkl2hdf5.py']}}
+save_json(OUT/'structure.json',result)
+print({'raw_max_error':max(x['raw_action_conversion_max_error'] for x in errors),
+    'state_action_max_error':max(x['state_vs_action_max_error'] for x in errors),'frequency':result['frequency_metadata_unique']})
