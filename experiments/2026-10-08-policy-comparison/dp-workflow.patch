+"""Frozen-checkpoint diagnostics on expert RGB/state, never training or tuning."""
+import argparse
+import json
+import time
+from pathlib import Path
+from common import ROOT, ACT_RUN, Episodes, build_policy, sha, save_json, torch, np
+
+RUN=ROOT/'data/dp_compare_20261007/run2000_v2'
+JOINTS=[i for i in range(14) if i not in (6,13)]
+
+def metrics(pred,target,state):
+    error=np.abs(pred-target)
+    active=np.any(target[:,[6,13]]<.8,axis=0)
+    return {'joint_mae_rad':float(error[:,JOINTS].mean()),
+        'first_joint_mae_rad':float(error[0,JOINTS].mean()),
+        'gripper_mae':float(error[:,[6,13]].mean()),
+        'gripper_binary_error':float(((pred[:,[6,13]]>.5)!=(target[:,[6,13]]>.5)).mean()),
+        'active_gripper_mae':float(error[:,[6,13]][:,active].mean()) if active.any() else None,
+        'state_hold_joint_mae_rad':float(np.abs(state[None,JOINTS]-target[:,JOINTS]).mean()),
+        'predicted_joint_motion_rad':float(np.abs(pred[:,JOINTS]-state[None,JOINTS]).mean()),
+        'expert_joint_motion_rad':float(np.abs(target[:,JOINTS]-state[None,JOINTS]).mean())}
+
+def summarize(rows):
+    keys=list(rows[0]['metrics'])
+    return {'samples':len(rows),**{k:float(np.mean([r['metrics'][k] for r in rows if r['metrics'][k] is not None]))
+        if any(r['metrics'][k] is not None for r in rows) else None for k in keys}}
+
+def main(output):
+    output.mkdir(parents=True,exist_ok=False)
+    torch.set_num_threads(4)
+    checkpoint=RUN/'training/2000.pt';digest=sha(checkpoint)
+    expected=json.loads((RUN/'experiment.json').read_text())['checkpoint_sha256']
+    assert digest==expected
+    payload=torch.load(checkpoint,map_location='cpu',weights_only=False)
+    assert payload['epoch']==2000 and payload['optimizer_steps']==80000
+    config=payload['config'];dataset=Episodes(config)
+    policy=build_policy(config,pretrained=False)
+    policy.load_state_dict(payload['ema']);policy.cuda().eval()
+    points=[]
+    events={}
+    for ep in dataset.train+dataset.val:
+        groups=dataset.groups[str(ep)]
+        tags={}
+        for name,ids in groups.items():tags.setdefault(int(ids[len(ids)//2]),[]).append(name)
+        ep_events=[]
+        for j in (6,13):
+            binary=dataset.actions[ep][:,j]>.5
+            for t in np.flatnonzero(binary[1:]!=binary[:-1])+1:
+                direction='open' if binary[t] else 'close'
+                ep_events.append({'frame':int(t),'gripper_dim':j,'direction':direction})
+                tags.setdefault(max(0,int(t)-4),[]).append(f'pre_{direction}_{j}')
+        events[str(ep)]=ep_events
+        for center,labels in sorted(tags.items()):
+            points.append((ep,center,labels))
+    metadata={'checkpoint_sha256':digest,'config':config,'status':'running','model_retrained':False,
+        'train_episodes':dataset.train,'validation_episodes':dataset.val,'samples_planned':len(points),
+        'selection':'seven phase-group midpoints plus four frames before every 0.5 gripper crossing; deduplicated',
+        'noise_seed_rule':'100000 + episode*1000 + center; repeats use +1000000*r',
+        'source_hashes':{str(p.relative_to(ROOT)):sha(p) for p in [Path(__file__),Path(__file__).with_name('common.py')]}}
+    save_json(output/'manifest.json',metadata)
+    rows=[];predictions=[];repeat_rows=[];begin=time.monotonic()
+    with (output/'points.jsonl').open('x',buffering=1) as log:
+        for idx,(ep,center,labels) in enumerate(points):
+            batch,_=dataset.sample(ep,center,critical=False)
+            seed=100000+ep*1000+center;torch.manual_seed(seed)
+            with torch.inference_mode(),torch.autocast('cuda',dtype=torch.bfloat16):
+                result=policy.predict_action(batch['obs'])
+            pred=result['action'][0].float().cpu().numpy()
+            full=result['action_pred'][0].float().cpu().numpy()
+            assert np.allclose(pred,full[config['n_obs_steps']-1:config['n_obs_steps']-1+8])
+            target=batch['action'][0,1:9].float().cpu().numpy();state=dataset.states[ep][center]
+            row={'episode':ep,'center':center,'labels':labels,'split':'train' if ep in dataset.train else 'validation',
+                'noise_seed':seed,'metrics':metrics(pred,target,state),'lag_joint_mae':{},'lag_gripper_mae':{}}
+            for lag in range(-4,5):
+                ids=np.clip(np.arange(center+lag,center+lag+8),0,dataset.lengths[ep]-1)
+                shifted=dataset.actions[ep][ids]
+                row['lag_joint_mae'][str(lag)]=float(np.abs(pred[:,JOINTS]-shifted[:,JOINTS]).mean())
+                row['lag_gripper_mae'][str(lag)]=float(np.abs(pred[:,[6,13]]-shifted[:,[6,13]]).mean())
+            row['events_in_chunk']=[]
+            for event in events[str(ep)]:
+                t=event['frame'];j=event['gripper_dim']
+                if center<=t<center+8:
+                    desired_open=event['direction']=='open'
+                    candidates=np.flatnonzero((pred[:,j]>.5)==desired_open)
+                    first=int(candidates[0]) if len(candidates) else None
+                    row['events_in_chunk'].append({**event,'expert_offset':t-center,'predicted_first_desired_offset':first,
+                        'timing_error_frames':None if first is None else first-(t-center),
+                        'predicted_before_value':float(pred[max(0,t-center-1),j]),
+                        'predicted_at_value':float(pred[t-center,j])})
+            rows.append(row);predictions.append(full);log.write(json.dumps(row)+'\n')
+            # Three extra noise draws at two critical validation phases.
+            if ep in dataset.val and any(x in labels for x in ['red_grasp','green_place']):
+                draws=[pred]
+                for repeat in range(1,4):
+                    torch.manual_seed(seed+repeat*1000000)
+                    with torch.inference_mode(),torch.autocast('cuda',dtype=torch.bfloat16):
+                        draw=policy.predict_action(batch['obs'])['action'][0].float().cpu().numpy()
+                    draws.append(draw)
+                repeat_rows.append({'episode':ep,'center':center,'labels':labels,
+                    'joint_std_rad':float(np.std(draws,axis=0)[:,JOINTS].mean()),
+                    'gripper_std':float(np.std(draws,axis=0)[:,[6,13]].mean()),
+                    'metrics_per_draw':[metrics(x,target,state) for x in draws]})
+            if (idx+1)%20==0 or idx+1==len(points):
+                save_json(output/'progress.json',{'status':'running','completed':idx+1,'total':len(points),
+                    'elapsed_seconds':time.monotonic()-begin})
+                print(f'expert points {idx+1}/{len(points)}',flush=True)
+    np.savez_compressed(output/'predictions.npz',action_pred=np.stack(predictions),
+        episodes=np.array([r['episode'] for r in rows]),centers=np.array([r['center'] for r in rows]))
+    summaries={s:summarize([r for r in rows if r['split']==s]) for s in ['train','validation']}
+    phases={s:{name:summarize([r for r in rows if r['split']==s and name in r['labels']])
+        for name in dataset.groups['0']} for s in ['train','validation']}
+    lag={s:{str(k):{'joint_mae':float(np.mean([r['lag_joint_mae'][str(k)] for r in rows if r['split']==s])),
+        'gripper_mae':float(np.mean([r['lag_gripper_mae'][str(k)] for r in rows if r['split']==s]))}
+        for k in range(-4,5)} for s in ['train','validation']}
+    alignment={}
+    for lag_frames in range(-3,4):
+        errors=[]
+        for ep in dataset.train+dataset.val:
+            ids=np.clip(np.arange(dataset.lengths[ep])+lag_frames,0,dataset.lengths[ep]-1)
+            errors.append(float(np.abs(dataset.actions[ep]-dataset.states[ep][ids]).mean()))
+        alignment[str(lag_frames)]=float(np.mean(errors))
+    final={'status':'completed','summaries':summaries,'phases':phases,'prediction_lag_sweep':lag,
+        'data_action_vs_shifted_state_mae':alignment,'gripper_events':events,'noise_repeats':repeat_rows,
+        'elapsed_seconds':time.monotonic()-begin,'checkpoint_sha256':digest,'model_retrained':False}
+    save_json(output/'results.json',final)
+    save_json(output/'progress.json',{'status':'completed','completed':len(rows),'total':len(rows)})
+    assert sha(checkpoint)==digest
+    print(json.dumps(summaries),flush=True)
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser();parser.add_argument('--output',type=Path,required=True)
+    main(parser.parse_args().output)
