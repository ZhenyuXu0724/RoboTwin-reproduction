+torch.set_num_threads(4); torch.manual_seed(0); np.random.seed(0)
+import sys
+sys.path.insert(0, str(ACT_RUN / 'evaluation50'))
+import serial_camera  # Same verified serialized RGB renderer as the ACT baseline.
+import scripts.eval_policy_xpolicylab as ev
+from envs.stack_blocks_two import stack_blocks_two
+from XPolicyLab.utils.process_data import decode_obs_images, pack_robot_state, unpack_robot_state, get_robot_action_dim_info
