+"""Matched-input experiment using XPolicyLab's vendored Diffusion Policy."""
+from pathlib import Path
+import sys
+import os
+
+ROOT = Path(__file__).resolve().parents[2]
+ACT_RUN = ROOT / 'data/demo_train50_wrist_v2/repaired_train2000_20261006_191143'
+DATA = ROOT / 'XPolicyLab/policy/ACT/processed_data/demo_train50_wrist_v2/stack_blocks_two/aloha_agilex-joint'
+sys.path[:0] = [str(ROOT / 'data/dp_runtime'), str(ROOT / 'XPolicyLab/policy/DP'), str(ROOT)]
+os.environ.setdefault('TORCH_HOME', str(ROOT / 'data/model_cache/torch'))
+os.environ.setdefault('MPLCONFIGDIR', '/tmp/robotwin-dp-matplotlib')
+os.environ.setdefault('ROBOTWIN_RAY_TRACING_DENOISER', 'none')
+os.environ.setdefault('OMP_NUM_THREADS', '4')
+os.environ.setdefault('MKL_NUM_THREADS', '4')
+
+import json
+import hashlib
+import numpy as np
+import torch
+import h5py
+from diffusion_policy.model.common.normalizer import LinearNormalizer
+from diffusion_policy.common.normalize_util import get_image_range_normalizer
+
+CAMERAS = ['cam_head', 'cam_right_wrist', 'cam_left_wrist']
+CONFIG = {
+    'horizon': 16, 'n_obs_steps': 2, 'n_action_steps': 8,
+    'diffusion_train_steps': 100, 'diffusion_inference_steps': 100,
+    'down_dims': [256, 512, 1024], 'image_shape': [3, 480, 640],
+    'action_dim': 14, 'seed': 0, 'epochs': 2000, 'updates_per_epoch': 40,
+    'batch_size': 1, 'lr': 1e-4, 'weight_decay': 1e-6,
+    'critical_sampling_ratio': 0.5, 'pretrained_resnet': 'IMAGENET1K_V1',
+    'precision': 'bfloat16 autocast; FP32 parameters', 'ema': True,
+    'rgbd_guard': False, 'depth_input': False,
+    'normalization': 'train-only min/max; DP native noise MSE',
+}
+
+def sha(path):
+    h = hashlib.sha256()
+    with Path(path).open('rb') as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b''):
+            h.update(chunk)
+    return h.hexdigest()
+
+def save_json(path, value):
+    path = Path(path)
+    tmp = path.with_suffix(path.suffix + '.tmp')
+    tmp.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
+    tmp.replace(path)
+
+def load_split():
+    split = json.loads((ROOT / 'data/demo_train50_wrist_v2/split_40_10.json').read_text())
+    train, val = split['train_episode_ids'], split['validation_episode_ids']
+    assert len(train) == 40 and len(val) == 10
+    assert set(train).isdisjoint(val) and set(train + val) == set(range(50))
+    return train, val
+
+def sequence_indices(center, length, config):
+    start = center - config['n_obs_steps'] + 1
+    return np.clip(np.arange(start, center + 1), 0, length - 1), np.clip(np.arange(start, start + config['horizon']), 0, length - 1)
+
+class Episodes:
+    def __init__(self, config=CONFIG):
+        self.config = config
+        self.train, self.val = load_split()
+        phases = json.loads((ACT_RUN / 'phase_samples.json').read_text())
+        self.groups = phases['episode_groups']
+        self.lengths, self.states, self.actions = {}, {}, {}
+        for ep in self.train + self.val:
+            with h5py.File(DATA / f'episode_{ep}.hdf5') as f:
+                assert f.attrs['action_start_offset'] == 0
+                self.states[ep] = f['observations/qpos'][()].astype(np.float32)
+                self.actions[ep] = f['action'][()].astype(np.float32)
+                self.lengths[ep] = len(self.actions[ep])
+                assert self.states[ep].shape == self.actions[ep].shape
+                assert self.actions[ep].shape[1] == config['action_dim']
+                for camera in CAMERAS:
+                    assert f[f'observations/images/{camera}'].shape == (self.lengths[ep], 480, 640, 3)
+            groups = self.groups[str(ep)]
+            assert groups and all(group for group in groups.values())
+            assert all(type(t) is int and 0 <= t < self.lengths[ep] for group in groups.values() for t in group)
+        self.rng = np.random.default_rng(config['seed'])
+
+    def normalizer(self):
+        norm = LinearNormalizer()
+        norm.fit({'action': np.concatenate([self.actions[i] for i in self.train]),
+                  'agent_pos': np.concatenate([self.states[i] for i in self.train])}, last_n_dims=1, mode='limits')
+        for cam in CAMERAS:
+            norm[cam] = get_image_range_normalizer()
+        return norm
+
+    def sample(self, ep, center=None, critical=True, device='cuda'):
+        if center is None:
+            if critical and self.rng.random() < self.config['critical_sampling_ratio']:
+                groups = list(self.groups[str(ep)].values())
+                group = groups[self.rng.integers(len(groups))]
+                center = int(self.rng.choice(group))
+            else:
+                center = int(self.rng.integers(self.lengths[ep]))
+        obs_ids, action_ids = sequence_indices(center, self.lengths[ep], self.config)
+        obs = {'agent_pos': torch.from_numpy(self.states[ep][obs_ids])[None].to(device)}
+        with h5py.File(DATA / f'episode_{ep}.hdf5') as f:
+            for cam in CAMERAS:
+                # Already-decoded RGB from the verified ACT conversion. No channel swap.
+                rgb = np.stack([f[f'observations/images/{cam}'][int(i)] for i in obs_ids])
+                rgb = np.ascontiguousarray(rgb.transpose(0, 3, 1, 2))
+                obs[cam] = torch.from_numpy(rgb).to(device=device, dtype=torch.float32)[None] / 255
+        return {'obs': obs, 'action': torch.from_numpy(self.actions[ep][action_ids])[None].to(device)}, center
+
+def build_policy(config=CONFIG, pretrained=True):
+    from torchvision.models import resnet18
+    from diffusers import DDPMScheduler
+    from diffusion_policy.model.vision.multi_image_obs_encoder import MultiImageObsEncoder
+    from diffusion_policy.policy.diffusion_unet_image_policy import DiffusionUnetImagePolicy
+    shape = {'obs': {cam: {'shape': config['image_shape'], 'type': 'rgb'} for cam in CAMERAS},
+             'action': {'shape': [config['action_dim']]}}
+    shape['obs']['agent_pos'] = {'shape': [config['action_dim']], 'type': 'low_dim'}
+    backbone = resnet18(weights=config['pretrained_resnet'] if pretrained else None)
+    backbone.fc = torch.nn.Identity()
+    encoder = MultiImageObsEncoder(shape, backbone, use_group_norm=True, share_rgb_model=False, imagenet_norm=True)
+    return DiffusionUnetImagePolicy(shape, DDPMScheduler(num_train_timesteps=config['diffusion_train_steps'], beta_schedule='squaredcos_cap_v2', clip_sample=True, prediction_type='epsilon'),
+        encoder, horizon=config['horizon'], n_action_steps=config['n_action_steps'], n_obs_steps=config['n_obs_steps'],
+        num_inference_steps=config['diffusion_inference_steps'], diffusion_step_embed_dim=128,
+        down_dims=config['down_dims'], kernel_size=5, n_groups=8, cond_predict_scale=True)
