+"""Add the authorized matched ACT RGB-D cohort after the DP RGB-D cohort finishes."""
+import datetime
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+import traceback
+from pathlib import Path
+from common import ROOT,ACT_RUN,sha,save_json
+from report_comparison import diagnostic
+
+OUTPUT=ROOT/'data/dp_compare_20261007/run2000_v2'
+GROUP=OUTPUT/'act_rgbd'
+
+def main():
+    GROUP.mkdir(exist_ok=True)
+    state={'status':'waiting_for_dp_rgbd','pid':os.getpid(),'started_at':datetime.datetime.now().astimezone().isoformat(),
+           'completed_cases':0,'retries':[],'tuning_during_evaluation':False,'model_retrained':False}
+    scripts=Path(__file__).parent
+    sources=[scripts/'visual_guard_initfix.py',scripts/'evaluate_act_rgbd.py',scripts/'act_rgbd_followup.py',scripts/'common.py',scripts/'report_comparison.py',
+        ACT_RUN/'visual_guard_test20_20261006_231054/visual_guard.py',
+        ACT_RUN/'visual_guard_test20_20261006_231054/serial_camera.py',
+        ACT_RUN/'visual_guard_test20_20261006_231054/act_eval_config.yml']
+    sources+=list((ROOT/'XPolicyLab/policy/ACT').rglob('*.py'))
+    state['source_hashes']={str(p.relative_to(ROOT)):sha(p) for p in sources}
+    def progress(status,**extra):
+        state.update(status=status,updated_at=datetime.datetime.now().astimezone().isoformat(),**extra)
+        save_json(GROUP/'progress.json',state)
+    def run_case(seed,steps,path):
+        path.mkdir(parents=True,exist_ok=False)
+        with (path/'eval.log').open('x') as log:
+            return subprocess.run([sys.executable,'-u',str(scripts/'evaluate_act_rgbd.py'),'--seed',str(seed),
+                '--steps',str(steps),'--output',str(path)],cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,timeout=1800)
+    try:
+        progress('waiting_for_dp_rgbd')
+        deadline=time.monotonic()+4*3600
+        while not (OUTPUT/'rgbd/results.json').exists():
+            dp=json.loads((OUTPUT/'rgbd/progress.json').read_text())
+            if dp['status']=='failed':raise RuntimeError('DP RGB-D cohort failed: '+dp.get('error',''))
+            if time.monotonic()>deadline:raise RuntimeError('DP RGB-D cohort did not finish within four hours')
+            time.sleep(30)
+        dp_result=json.loads((OUTPUT/'rgbd/results.json').read_text())
+        assert dp_result['status']=='completed' and len(dp_result['rows'])==20
+        pure=json.loads((OUTPUT/'comparison.json').read_text())
+        manifest=json.loads((OUTPUT/'experiment.json').read_text())
+        state.update(seeds=manifest['fresh_test_seeds'],steps_limit=800,
+            act_checkpoint_sha256=manifest['act_checkpoint_sha256'],dp_checkpoint_sha256=manifest['checkpoint_sha256'])
+        assert sha(Path(manifest['act_checkpoint'])/'policy_last.ckpt')==state['act_checkpoint_sha256']
+        save_json(GROUP/'frozen_manifest.json',state)
+        progress('act_rgbd_wiring_smoke')
+        smoke=run_case(200000,2,GROUP/'wiring-smoke');assert smoke.returncode==0,'ACT RGB-D wiring smoke failed'
+        rows=[]
+        for seed in state['seeds']:
+            for rel,digest in state['source_hashes'].items():assert sha(ROOT/rel)==digest,f'Source changed: {rel}'
+            for attempt in range(1,4):
+                case=GROUP/f'ACT_RGBD-seed{seed}-attempt{attempt}'
+                progress('evaluating_act_rgbd',current_seed=seed,current_attempt=attempt,completed_cases=len(rows))
+                result=run_case(seed,800,case)
+                if result.returncode==0:
+                    row=json.loads((case/'result.json').read_text());assert row['valid'] and row['actual_seed']==seed
+                    dp=next(r for r in dp_result['rows'] if r['seed']==seed)
+                    baseline=next(r for r in pure['rows'] if r['policy']=='ACT' and r['cohort']=='fresh_test' and r['seed']==seed)
+                    assert row['initial']==dp['initial']==baseline['initial'],'Matched cohort scene mismatch'
+                    row.update(cohort='fresh_test',result_path=str(case/'result.json'));rows.append(row)
+                    save_json(GROUP/'results.partial.json',rows)
+                    progress('evaluating_act_rgbd',completed_cases=len(rows),successes=sum(r['success'] for r in rows));break
+                state['retries'].append({'seed':seed,'attempt':attempt,'returncode':result.returncode,'log':str(case/'eval.log')})
+                progress('evaluating_act_rgbd')
+                if result.returncode not in [-signal.SIGSEGV,-signal.SIGABRT]:raise RuntimeError(f'ACT RGB-D evaluation error {seed}: {result.returncode}')
+            else:raise RuntimeError(f'Three native crashes at seed {seed}')
+        assert len(rows)==20
+        save_json(GROUP/'results.json',{'status':'completed','valid_cases':20,'successes':sum(r['success'] for r in rows),
+            'success_rate':sum(r['success'] for r in rows)/20,'rows':rows})
+        all_rows=[r for r in pure['rows'] if r['cohort']=='fresh_test']+dp_result['rows']+rows
+        summaries={}
+        for policy in ['ACT','DP','ACT_RGBD','DP_RGBD']:
+            cases=[r for r in all_rows if r['policy']==policy];assert len(cases)==20
+            diag=[diagnostic(r) for r in cases]
+            summaries[policy]={'successes':sum(r['success'] for r in cases),'valid_cases':20,
+                'red_sustained_lift_proxy':sum(d['red_sustained_lift_proxy'] for d in diag),
+                'green_sustained_lift_proxy':sum(d['green_sustained_lift_proxy'] for d in diag),
+                'mean_steps':sum(r['steps'] for r in cases)/20,
+                'corrected_steps':sum(r.get('corrected_steps',0) for r in cases),'replans':sum(r.get('replans',0) for r in cases)}
+        pairs={}
+        for seed in state['seeds']:
+            a=next(r for r in rows if r['seed']==seed);d=next(r for r in dp_result['rows'] if r['seed']==seed)
+            key=f"ACT_RGBD_{int(a['success'])}_DP_RGBD_{int(d['success'])}";pairs[key]=pairs.get(key,0)+1
+        save_json(OUTPUT/'FOUR_WAY_COMPARISON.json',{'status':'completed','summaries':summaries,'rgbd_paired_outcomes':pairs,
+            'rows':all_rows,'seeds':state['seeds'],'source_hashes':state['source_hashes']})
+        lines=['# 堆叠方块 ACT 与 DP 及 RGB-D 纠偏对照报告','',
+            '四组使用同一批 20 个种子、严格相同的初始方块位置和每场最多 800 步的预算。训练数据均为 50 条演示和固定 40/10 划分，两个模型均训练 2000 轮。RGB-D 组不重新训练模型。',
+            '', '## 同场景结果','', '| 策略 | 官方成功数 | 红块持续抬升代理 | 绿块持续抬升代理 | 平均动作步数 | 纠偏改写动作步数 | 纠偏后重新预测次数 |',
+            '| --- | --- | --- | --- | --- | --- | --- |']
+        for policy,s in summaries.items():lines.append(f"| {policy} | {s['successes']}/20 | {s['red_sustained_lift_proxy']}/20 | {s['green_sustained_lift_proxy']}/20 | {s['mean_steps']:.1f} | {s['corrected_steps']} | {s['replans']} |")
+        lines+=['', '## RGB-D 组的配对结果','',json.dumps(pairs,ensure_ascii=False),
+            '', '## 解释边界','',
+            '持续抬升代理为相对初始高度超过 2.5 cm 且连续至少 5 个动作步，不代表经过夹持验证的抓取成功。官方成功要求堆叠位置容差满足且双夹爪打开，未额外验证释放后的长期稳定性。',
+            'ACT 与 DP 使用各自既有的 2000 轮权重。两组 RGB-D 复用同一个 visual_guard_v2_initfix，仅修复释放分支缺少运动学初始化的缺陷，所有纠偏阈值不变。修复前结果及无效异常尝试单独保留，不混入本轮 20 场统计。控制器使用深度、相机标定、已知红绿颜色和 5 cm 尺寸；方块真值只供事后评分，不进入控制器决策。DP 和 ACT 网络仍只接收 RGB 与关节。',
+            'ACT 预测并缓存执行 50 步；DP 预测 16 步并执行 8 步，观测历史、损失和精度也不同。纠偏后的 ACT 清空缓存重新预测，DP 清空未执行动作但保留实际两帧观测历史。该比较评估既有组合系统，不是只改变网络架构的严格消融。',
+            '历史 ACT 加 RGB-D 的 19/20 属于另一批种子，不参与本轮配对排名。原生进程崩溃的无效尝试保留并同种子重试，不计为任务失败。当前仅一个训练种子与 20 个场景，结果不宜直接推广成算法优劣。']
+        (OUTPUT/'FOUR_WAY_COMPARISON.md').write_text('\n'.join(lines)+'\n')
+        progress('completed',completed_cases=20,summaries=summaries,report=str(OUTPUT/'FOUR_WAY_COMPARISON.md'))
+    except Exception as error:
+        progress('failed',error=str(error),traceback=traceback.format_exc());raise
+
+if __name__=='__main__':
+    if '--detach' in sys.argv:
+        GROUP.mkdir(exist_ok=True)
+        with (GROUP/'coordinator.log').open('x') as log:
+            process=subprocess.Popen([sys.executable,'-u',__file__],cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
+        print('Matched ACT RGB-D follow-up launched:',process.pid)
+    else:main()
