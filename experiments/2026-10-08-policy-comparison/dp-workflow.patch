+"""Resume immutable paired evaluation; retry native crashes, never task failures."""
+import datetime
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import traceback
+from common import ROOT, sha, save_json
+
+OUTPUT = ROOT/'data/dp_compare_20261007/run2000_v2'
+
+def main():
+    manifest = json.loads((OUTPUT/'experiment.json').read_text())
+    state = {'status':'verifying', 'pid':os.getpid(), 'started_at':datetime.datetime.now().astimezone().isoformat(),
+             'original_failure':manifest.get('error'), 'source_sha256':sha(__file__), 'retries':[]}
+    def progress(status, **extra):
+        state.update(status=status, updated_at=datetime.datetime.now().astimezone().isoformat(), **extra)
+        save_json(OUTPUT/'evaluation_resume.json',state)
+    try:
+        progress('verifying')
+        assert manifest['training_complete']
+        metrics=[json.loads(line) for line in (OUTPUT/'training/metrics.jsonl').read_text().splitlines()]
+        assert len(metrics)==2000 and metrics[-1]['optimizer_steps']==80000
+        for rel, digest in manifest['source_hashes'].items():
+            assert sha(ROOT/rel)==digest, f'Frozen source changed: {rel}'
+        assert sha(OUTPUT/'training/2000.pt')==manifest['checkpoint_sha256']
+        assert sha(Path(manifest['act_checkpoint'])/'policy_last.ckpt')==manifest['act_checkpoint_sha256']
+        for rel, info in manifest['dataset_files'].items():
+            stat=(ROOT/rel).stat()
+            assert (stat.st_size,stat.st_mtime_ns)==(info['bytes'],info['mtime_ns'])
+        rows=json.loads((OUTPUT/'results.partial.json').read_text())
+        saved={(r['cohort'],r['policy'],r['seed']):r for r in rows}
+        assert len(saved)==len(rows)
+        for row in rows:
+            assert row['valid'] and row['complete'] and row['actual_seed']==row['seed']
+            assert not row['depth_input'] and not row['rgbd_guard']
+        progress('evaluation',completed_cases=len(rows),verification='passed')
+        for cohort,seeds in [('development',manifest['development_seeds']),('fresh_test',manifest['fresh_test_seeds'])]:
+            for seed in seeds:
+                pair=[]
+                for policy in (['ACT','DP'] if (seed//100000)%2 else ['DP','ACT']):
+                    key=(cohort,policy,seed)
+                    if key in saved:
+                        pair.append(saved[key]); continue
+                    original=OUTPUT/'evaluation'/cohort/f'{policy}-seed{seed}'
+                    for attempt in range(1,4):
+                        case=original.parent/f'{original.name}-resume{attempt}'
+                        case.mkdir(exist_ok=False)
+                        command=[sys.executable,'-u',str(ROOT/'scripts/dp_comparison/evaluate.py'),
+                            '--policy',policy,'--seed',str(seed),'--steps','800','--output',str(case),
+                            '--checkpoint',str(OUTPUT/'training/2000.pt')]
+                        progress('evaluation',current_case={'policy':policy,'seed':seed,'attempt':attempt},completed_cases=len(rows))
+                        with (case/'eval.log').open('x') as log:
+                            result=subprocess.run(command,cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,timeout=1800)
+                        if result.returncode==0:
+                            row=json.loads((case/'result.json').read_text())
+                            assert row['valid'] and row['actual_seed']==seed
+                            row.update(cohort=cohort,result_path=str(case/'result.json'))
+                            rows.append(row);saved[key]=row;pair.append(row)
+                            save_json(OUTPUT/'results.partial.json',rows)
+                            break
+                        state['retries'].append({'policy':policy,'seed':seed,'attempt':attempt,'exit_code':result.returncode,'log':str(case/'eval.log')})
+                        progress('evaluation')
+                        # Only a native process crash is retryable, with the same
+                        # immutable policy, seed, action budget and evaluator.
+                        if result.returncode not in [-signal.SIGSEGV,-signal.SIGABRT]:
+                            raise RuntimeError(f'Non-native evaluation error: {policy} seed {seed}, return {result.returncode}')
+                    else:
+                        raise RuntimeError(f'Three native crashes: {policy} seed {seed}')
+                assert pair[0]['initial']==pair[1]['initial'], f'Paired scene mismatch: {seed}'
+                progress('evaluation',completed_cases=len(rows))
+        assert len(rows)==50
+        summaries={}
+        for cohort in ['development','fresh_test']:
+            summaries[cohort]={}
+            for policy in ['ACT','DP']:
+                cases=[r for r in rows if r['cohort']==cohort and r['policy']==policy]
+                summaries[cohort][policy]={'valid_cases':len(cases),'successes':sum(r['success'] for r in cases),
+                    'success_rate':sum(r['success'] for r in cases)/len(cases),
+                    'mean_steps':sum(r['steps'] for r in cases)/len(cases),
+                    'mean_prediction_seconds':sum(r['prediction_seconds'] for r in cases)/sum(r['prediction_calls'] for r in cases)}
+        paired={}
+        for seed in manifest['fresh_test_seeds']:
+            pair={r['policy']:r for r in rows if r['cohort']=='fresh_test' and r['seed']==seed}
+            label=f"ACT_{int(pair['ACT']['success'])}_DP_{int(pair['DP']['success'])}"
+            paired[label]=paired.get(label,0)+1
+        save_json(OUTPUT/'comparison.json',{'status':'completed','summaries':summaries,'paired_outcomes':paired,
+            'rows':rows,'limitations':manifest['comparison_note'],'native_crash_recovery':state})
+        report=['# Pure DP vs pure ACT comparison','','Both: 50 demos, same 40/10 split, 2000 epochs / 80000 updates, three RGB cameras and joints. No depth or RGB-D guard.','',
+            '| Cohort | Policy | Success | Mean steps | Mean prediction time (s) |','| --- | --- | --- | --- | --- |']
+        for cohort,policies in summaries.items():
+            for policy,info in policies.items():
+                report.append(f"| {cohort} | {policy} | {info['successes']}/{info['valid_cases']} | {info['mean_steps']:.1f} | {info['mean_prediction_seconds']:.4f} |")
+        report+=['',manifest['comparison_note'],'Single training seed; 20 fresh paired scenes. Historical RGB-D-assisted 95% is not a pure-policy score.',
+            'Native crash attempts were preserved and excluded from task-success denominators. Same-seed retries used unchanged frozen checkpoints and evaluator.']
+        (OUTPUT/'REPORT.md').write_text('\n'.join(report)+'\n')
+        manifest.update(phase='completed',completed_cases=50,summaries=summaries,evaluation_recovery=str(OUTPUT/'evaluation_resume.json'),
+            updated_at=datetime.datetime.now().astimezone().isoformat())
+        save_json(OUTPUT/'experiment.json',manifest)
+        progress('completed',completed_cases=50,summaries=summaries)
+    except Exception as error:
+        progress('failed',error=str(error),traceback=traceback.format_exc()); raise
+
+if __name__=='__main__':
+    if '--detach' in sys.argv:
+        with (OUTPUT/'resume.log').open('x') as log:
+            process=subprocess.Popen([sys.executable,'-u',__file__],cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
+        print('Evaluation recovery launched:',process.pid)
+    else:
+        main()
