+"""Evidence-based Chinese reports, distinguishing pose proxies from grasp success."""
+import json
+from pathlib import Path
+import numpy as np
+from common import ROOT,save_json
+
+OUTPUT=ROOT/'data/dp_compare_20261007/run2000_v2'
+
+def longest(values):
+    run=best=0
+    for value in values:
+        run=run+1 if value else 0;best=max(best,run)
+    return best
+
+def diagnostic(row):
+    source=Path(row.get('result_path',OUTPUT/'evaluation'/row['cohort']/f"{row['policy']}-seed{row['seed']}"/'result.json'))
+    trace=[json.loads(line) for line in (source.parent/'trace.jsonl').read_text().splitlines()]
+    assert len(trace)==row['steps']
+    result={}
+    for color in ['red','green']:
+        positions=np.asarray([r['poses_for_scoring_only'][color] for r in trace])
+        lift=positions[:,2]-row['initial'][color][2]
+        result[color+'_max_lift_cm']=float(lift.max()*100)
+        result[color+'_sustained_lift_proxy']=longest(lift>.025)>=5
+    red=np.asarray([r['poses_for_scoring_only']['red'] for r in trace])
+    green=np.asarray([r['poses_for_scoring_only']['green'] for r in trace])
+    result['red_base_geometry_proxy']=bool(result['red_sustained_lift_proxy'] and
+        np.any((np.abs(red[:,0])<.025)&(np.abs(red[:,1]+.13)<.025)&(np.abs(red[:,2]-row['initial']['red'][2])<.012)))
+    error=green-red-np.array([0,0,.05])
+    result['sustained_stack_geometry_proxy']=longest(np.all(np.abs(error)<[.025,.025,.012],axis=1))>=5
+    result['final_stack_xy_error_cm']=float(np.linalg.norm(error[-1,:2])*100)
+    result['final_stack_z_error_cm']=float(abs(error[-1,2])*100)
+    result['mode']=('L' if row['initial']['red'][0]<0 else 'R')+('L' if row['initial']['green'][0]<0 else 'R')
+    return result
+
+def generate(include_rgbd=False):
+    comparison=json.loads((OUTPUT/'comparison.json').read_text());assert comparison['status']=='completed'
+    rows=comparison['rows']
+    if include_rgbd:
+        extra=json.loads((OUTPUT/'rgbd/results.json').read_text());assert extra['status']=='completed'
+        rows=rows+extra['rows']
+    augmented=[{**row,'diagnostic':diagnostic(row)} for row in rows]
+    summaries={}
+    for cohort in ['development','fresh_test']:
+        summaries[cohort]={}
+        for policy in ['ACT','DP','DP_RGBD']:
+            cases=[r for r in augmented if r['cohort']==cohort and r['policy']==policy]
+            if not cases:continue
+            summaries[cohort][policy]={
+                'valid_cases':len(cases),'successes':sum(r['success'] for r in cases),
+                **{key:sum(r['diagnostic'][key] for r in cases) for key in
+                   ['red_sustained_lift_proxy','green_sustained_lift_proxy','red_base_geometry_proxy','sustained_stack_geometry_proxy']},
+                'median_final_xy_cm':float(np.median([r['diagnostic']['final_stack_xy_error_cm'] for r in cases])),
+                'mean_model_seconds_per_action':sum(r['prediction_seconds'] for r in cases)/sum(r['steps'] for r in cases)}
+    suffix='RGBD_COMPARISON' if include_rgbd else 'PURE_COMPARISON'
+    save_json(OUTPUT/(suffix+'.json'),{'status':'completed','summaries':summaries,'rows':augmented})
+    lines=['# 堆叠方块 DP 与 ACT 对照报告','',
+        '本报告比较同一批 50 条轨迹和固定 40/10 划分下训练 2000 轮的纯 DP 与纯 ACT。两者均使用三路 640×480 RGB 和关节输入，关闭深度输入及 RGB-D 纠偏，每个场景最多执行 800 步。',
+        '', '## 官方成功率','', '| 场景 | 策略 | 成功数 | 有效场景数 |','| --- | --- | --- | --- |']
+    for cohort,policies in summaries.items():
+        for policy,s in policies.items():lines.append(f"| {cohort} | {policy} | {s['successes']} | {s['valid_cases']} |")
+    lines+=['','## 行为阶段与计算开销','',
+        '下面的位姿指标只用于事后评分，不进入策略决策。持续抬升定义为相对初始高度增加超过 2.5 cm 且连续至少 5 个动作步；它不是经过夹持验证的抓取成功。红块底座位置指标要求此前出现持续抬升，且某时刻进入底座位置附近。堆叠几何指标仅检查相对位置连续 5 步，不检查夹爪打开或长期稳定。',
+        '', '| 场景 | 策略 | 红块持续抬升 | 红块底座位置 | 绿块持续抬升 | 持续堆叠几何 | 最终 XY 误差中位数 cm | 推理秒数每动作步 |',
+        '| --- | --- | --- | --- | --- | --- | --- | --- |']
+    for cohort,policies in summaries.items():
+        for policy,s in policies.items():lines.append(f"| {cohort} | {policy} | {s['red_sustained_lift_proxy']}/{s['valid_cases']} | {s['red_base_geometry_proxy']}/{s['valid_cases']} | {s['green_sustained_lift_proxy']}/{s['valid_cases']} | {s['sustained_stack_geometry_proxy']}/{s['valid_cases']} | {s['median_final_xy_cm']:.2f} | {s['mean_model_seconds_per_action']:.4f} |")
+    pure=[summaries['fresh_test'][p] for p in ['ACT','DP']]
+    if all(s['successes']==0 for s in pure):
+        lines+=['','## 结论','', '纯 DP 与纯 ACT 在本轮新场景上的官方成功率都为零，出现了成功率指标的地板效应。结果能够说明当前两套训练与部署方案都没有达到可用的自主堆叠能力，但不能据此宣称两种算法性能等价，或判定 DP 不如 ACT。行为阶段指标帮助定位卡在哪一步，也不能代替任务成功率。']
+    else:
+        lines+=['','## 结论','', '官方成功率与行为阶段指标应一起解释。当前是单个训练种子的有限场景比较，不能将观察到的差异直接推广成算法优劣。']
+    lines+=['', '训练损失是各自目标上的拟合指标，不等于闭环成功率；DP 噪声 MSE 与 ACT 重建损失不能直接横向比较。数据量与覆盖、部署时分布偏移、动作执行频率和关键接触阶段误差都可能影响结果，本轮尚未将这些原因单独隔离。',
+        '', '## 比较边界','',
+        '两者均为 80000 次更新，但模型、损失、归一化和精度不同。DP 使用 EMA、两帧观测、预测 16 步并执行 8 步；ACT 使用单帧观测、预测并缓存执行 50 步。因此这是现有方案的对照，不是只改变模型架构的严格消融。',
+        '本轮新场景种子为 2700000 至 4600000。原生进程崩溃的无效尝试保留，并以冻结模型和相同种子重试，不计作任务失败；模型及纠偏阈值未按测试结果修改。',
+        '历史 ACT 加 RGB-D 的 19/20 使用另一批种子，仅作历史参照，不能与本轮成功率作直接配对排名。']
+    if include_rgbd:
+        lines+=['','## RGB-D 对照条件','',
+            'DP 加 RGB-D 复用同一个 2000 轮 DP checkpoint，不重新训练。深度和相机标定只进入 visual_guard_v2_initfix：仅修复释放分支缺少运动学初始化的缺陷，所有阈值不变，修复前结果单独保留而不混入本轮统计。DP 网络仍仅接收 RGB 与关节。纠偏逐动作步执行，纠偏后的重新预测清空未执行动作缓存，但保留最新实际 RGB 观测历史。',
+            '这一组测试的是组合控制系统的收益，不是 DP 学会了利用深度，也不是纯 DP 泛化能力的提升。已知红绿颜色和 5 cm 方块尺寸仍是额外先验。']
+    else:
+        lines+=['','## 下一组对照','', '下一组使用同一个 DP checkpoint 和同一批 20 个新场景，加入已有的冻结 RGB-D 校正模块，不修改模型或校正阈值。其成绩应与本轮纯 DP 配对比较，用于判断额外几何纠偏能补足哪些阶段。']
+    (OUTPUT/(suffix+'.md')).write_text('\n'.join(lines)+'\n')
+    return summaries
+
+if __name__=='__main__':
+    import sys
+    print(generate('--rgbd' in sys.argv))
