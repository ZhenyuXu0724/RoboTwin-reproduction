+"""Ensure the single branch is the only code difference and no-release behavior works."""
+import ast
+import io
+import json
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+import numpy as np
+import visual_guard_no_release as module
+
+
+class AblationContract(unittest.TestCase):
+    def test_only_release_condition_differs(self):
+        root=Path(__file__).parent
+        before=ast.parse((root/'visual_guard_initfix.py').read_text())
+        after=ast.parse((root/'visual_guard_no_release.py').read_text())
+        altered=[n for n in ast.walk(after) if isinstance(n,ast.If) and isinstance(n.test,ast.BoolOp)
+            and isinstance(n.test.values[0],ast.Constant) and n.test.values[0].value is False]
+        self.assertEqual(len(altered),1)
+        altered[0].test.values=altered[0].test.values[1:]
+        self.assertEqual(ast.dump(before),ast.dump(after))
+
+    def test_no_release_intervention_but_estimation_kept(self):
+        guard=module.VisualGuard.__new__(module.VisualGuard)
+        guard.log=io.StringIO();guard.kin={};guard.initial={'green':np.array([-.1,0,.7])}
+        guard.sides={'green':'left'};guard.attempted={'red':True,'green':True}
+        guard.red_lifted=True;guard.red_placed=True;guard.green_lifted=True
+        guard.green_released=False;guard.settle=0
+        task=SimpleNamespace(robot=object(),cameras=None,take_action_cnt=250)
+        centers={'red':np.array([-.1,0,.75]),'green':np.array([-.15,0,.82])}
+        action=np.zeros(14);action[6]=1
+        with patch.object(module,'estimate_cube',side_effect=lambda c,color:{'center':centers[color],'pixels':{}}):
+            actual=guard.filter(task,action)
+        np.testing.assert_array_equal(actual,action)
+        self.assertFalse(guard.green_released)
+        self.assertFalse(json.loads(guard.log.getvalue())['corrected'])
+
+if __name__=='__main__':
+    import json
+    unittest.main()
