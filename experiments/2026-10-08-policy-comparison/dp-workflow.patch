+"""Wait for pure comparison, write report, then run the authorized DP RGB-D group."""
+import datetime
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+import traceback
+from pathlib import Path
+from common import ROOT,ACT_RUN,sha,save_json
+from report_comparison import generate
+
+OUTPUT=ROOT/'data/dp_compare_20261007/run2000_v2'
+GROUP=OUTPUT/'rgbd'
+
+def main():
+    GROUP.mkdir(exist_ok=True)
+    state={'status':'waiting_for_pure_comparison','pid':os.getpid(),
+        'started_at':datetime.datetime.now().astimezone().isoformat(),'completed_cases':0,'retries':[],
+        'tuning_during_evaluation':False,'model_retrained':False}
+    scripts=Path(__file__).parent
+    sources=[scripts/'visual_guard_initfix.py',scripts/'evaluate_rgbd.py',scripts/'report_comparison.py',scripts/'rgbd_followup.py',scripts/'common.py',
+        ACT_RUN/'visual_guard_test20_20261006_231054/visual_guard.py',
+        ACT_RUN/'visual_guard_test20_20261006_231054/serial_camera.py']
+    state['source_hashes']={str(p.relative_to(ROOT)):sha(p) for p in sources}
+    def progress(status,**extra):
+        state.update(status=status,updated_at=datetime.datetime.now().astimezone().isoformat(),**extra)
+        save_json(GROUP/'progress.json',state)
+    def run_case(seed,steps,path):
+        path.mkdir(parents=True,exist_ok=False)
+        with (path/'eval.log').open('x') as log:
+            return subprocess.run([sys.executable,'-u',str(scripts/'evaluate_rgbd.py'),'--seed',str(seed),
+                '--steps',str(steps),'--output',str(path),'--checkpoint',str(OUTPUT/'training/2000.pt')],
+                cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,timeout=1800)
+    try:
+        progress('waiting_for_pure_comparison')
+        deadline=time.monotonic()+3*3600
+        while not (OUTPUT/'comparison.json').exists():
+            recovery=json.loads((OUTPUT/'evaluation_resume.json').read_text())
+            if recovery['status']=='failed':raise RuntimeError('Pure-policy evaluation recovery failed: '+recovery.get('error',''))
+            if time.monotonic()>deadline:raise RuntimeError('Pure comparison did not finish within three hours')
+            time.sleep(30)
+        comparison=json.loads((OUTPUT/'comparison.json').read_text())
+        assert comparison['status']=='completed' and len(comparison['rows'])==50
+        pure_summaries=json.loads((OUTPUT/'PURE_COMPARISON.json').read_text())['summaries']
+        progress('pure_report_ready',pure_report=str(OUTPUT/'PURE_COMPARISON.md'),pure_summaries=pure_summaries)
+        manifest=json.loads((OUTPUT/'experiment.json').read_text())
+        assert sha(OUTPUT/'training/2000.pt')==manifest['checkpoint_sha256']
+        state['checkpoint_sha256']=manifest['checkpoint_sha256']
+        state['seeds']=manifest['fresh_test_seeds'];state['steps_limit']=800
+        save_json(GROUP/'frozen_manifest.json',state)
+        # Wiring smoke is not a task-success measurement or tuning opportunity.
+        progress('rgbd_wiring_smoke')
+        smoke=run_case(200000,2,GROUP/'wiring-smoke')
+        assert smoke.returncode==0,'RGB-D wiring smoke failed'
+        assert json.loads((GROUP/'wiring-smoke/result.json').read_text())['valid']
+        rows=[]
+        for seed in state['seeds']:
+            for rel,digest in state['source_hashes'].items():assert sha(ROOT/rel)==digest,f'Frozen source changed: {rel}'
+            for attempt in range(1,4):
+                case=GROUP/f'DP_RGBD-seed{seed}-attempt{attempt}'
+                progress('evaluating_rgbd',current_seed=seed,current_attempt=attempt,completed_cases=len(rows))
+                result=run_case(seed,800,case)
+                if result.returncode==0:
+                    row=json.loads((case/'result.json').read_text())
+                    assert row['valid'] and row['actual_seed']==seed
+                    pure=next(r for r in comparison['rows'] if r['policy']=='DP' and r['cohort']=='fresh_test' and r['seed']==seed)
+                    assert row['initial']==pure['initial'],'DP/DP-RGBD initial scene mismatch'
+                    row.update(cohort='fresh_test',result_path=str(case/'result.json'))
+                    rows.append(row)
+                    save_json(GROUP/'results.partial.json',rows)
+                    progress('evaluating_rgbd',completed_cases=len(rows),successes=sum(r['success'] for r in rows))
+                    break
+                state['retries'].append({'seed':seed,'attempt':attempt,'returncode':result.returncode,'log':str(case/'eval.log')})
+                progress('evaluating_rgbd')
+                if result.returncode not in [-signal.SIGSEGV,-signal.SIGABRT]:
+                    raise RuntimeError(f'RGB-D evaluation error seed {seed}: {result.returncode}')
+            else:raise RuntimeError(f'Three native crashes at seed {seed}')
+        assert len(rows)==20
+        save_json(GROUP/'results.json',{'status':'completed','successes':sum(r['success'] for r in rows),
+            'valid_cases':20,'success_rate':sum(r['success'] for r in rows)/20,'rows':rows})
+        summaries=generate(include_rgbd=True)
+        progress('completed',completed_cases=20,summaries=summaries,report=str(OUTPUT/'RGBD_COMPARISON.md'))
+    except Exception as error:
+        progress('failed',error=str(error),traceback=traceback.format_exc());raise
+
+if __name__=='__main__':
+    if '--detach' in sys.argv:
+        GROUP.mkdir(exist_ok=True)
+        with (GROUP/'coordinator.log').open('x') as log:
+            process=subprocess.Popen([sys.executable,'-u',__file__],cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
+        print('Pure report then DP RGB-D workflow launched:',process.pid)
+    else:main()
