+"""Replay unchanged pure DP once; record execution response for diagnosis only."""
+import argparse
+import json
+import runpy
+import sys
+import time
+from pathlib import Path
+from common import ROOT, torch, np
+from envs.stack_blocks_two import stack_blocks_two
+from visual_guard_initfix import Kinematics
+
+parser=argparse.ArgumentParser();parser.add_argument('--output',type=Path,required=True)
+parser.add_argument('--seed',type=int,default=2700000)
+cli=parser.parse_args();cli.output.mkdir(parents=True,exist_ok=False)
+log=(cli.output/'execution.jsonl').open('x',buffering=1)
+original=stack_blocks_two.take_action
+kin={}
+
+def state(robot):
+    return np.r_[robot.get_left_arm_real_jointState()[:6],robot.get_left_gripper_val(),
+        robot.get_right_arm_real_jointState()[:6],robot.get_right_gripper_val()]
+
+def measured(self,action,action_type='qpos'):
+    before=state(self.robot);command=np.asarray(action)
+    target_state=np.asarray(self.robot.get_left_arm_jointState()+self.robot.get_right_arm_jointState())
+    if not kin:
+        for side in ['left','right']:kin[side]=Kinematics(self.robot,side)
+    tcp={side:kin[side].pose(before[j:j+6])[0].tolist() for side,j in [('left',0),('right',7)]}
+    positions={c:getattr(self,attr).get_pose().p.tolist() for c,attr in [('red','block1'),('green','block2')]}
+    durations={};restores=[]
+    for side in ['left','right']:
+        planner=getattr(self.robot,side+'_mplib_planner');old=planner.TOPP
+        def wrapped(*args,_old=old,_side=side,**kwargs):
+            result=_old(*args,**kwargs)
+            durations[_side]={'interpolation_samples':int(result[1].shape[0]),'reported_duration':float(result[-1])}
+            return result
+        planner.TOPP=wrapped;restores.append((planner,old))
+    begin=time.monotonic()
+    try:result=original(self,action,action_type)
+    finally:
+        for planner,old in restores:planner.TOPP=old
+    after=state(self.robot)
+    log.write(json.dumps({'step':int(self.take_action_cnt),'before':before.tolist(),'policy_input_target_state':target_state.tolist(),'command':command.tolist(),
+        'after':after.tolist(),'tcp_before_for_diagnosis_only':tcp,'cube_before_for_diagnosis_only':positions,
+        'planner':durations,'wall_seconds':time.monotonic()-begin})+'\n')
+    return result
+
+stack_blocks_two.take_action=measured
+sys.argv=['evaluate.py','--policy','DP','--seed',str(cli.seed),'--steps','800','--output',str(cli.output),
+    '--checkpoint',str(ROOT/'data/dp_compare_20261007/run2000_v2/training/2000.pt')]
+try:runpy.run_path(str(Path(__file__).with_name('evaluate.py')),run_name='__main__')
+finally:log.close()
