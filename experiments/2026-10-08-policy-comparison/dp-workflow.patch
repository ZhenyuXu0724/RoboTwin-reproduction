+"""Predeclared matched ACT release-component ablation; no training or tuning."""
+import datetime
+import json
+import os
+import signal
+import subprocess
+import sys
+import traceback
+from pathlib import Path
+from common import ROOT,ACT_RUN,sha,save_json,np
+from report_comparison import diagnostic
+
+RUN=ROOT/'data/dp_compare_20261007/run2000_v2'
+GROUP=RUN/'act_release_ablation_20261008'
+HYPOTHESIS='Release alignment improves stacking after lifting green, beyond grasp alignment alone.'
+
+def main():
+    GROUP.mkdir(exist_ok=True)
+    scripts=Path(__file__).parent
+    sources=[Path(__file__),scripts/'evaluate_act_ablation.py',scripts/'evaluate_act_rgbd.py',
+        scripts/'visual_guard_no_release.py',scripts/'visual_guard_initfix.py',scripts/'common.py',
+        scripts/'report_comparison.py',ROOT/'scripts/eval_policy_xpolicylab.py',ROOT/'envs/_base_task.py',
+        ROOT/'envs/camera/camera.py',ACT_RUN/'visual_guard_test20_20261006_231054/serial_camera.py',
+        ACT_RUN/'visual_guard_test20_20261006_231054/act_eval_config.yml']
+    sources+=list((ROOT/'XPolicyLab/policy/ACT').rglob('*.py'))
+    experiment=json.loads((RUN/'experiment.json').read_text())
+    full=json.loads((RUN/'act_rgbd/results.json').read_text())['rows']
+    pure=[r for r in json.loads((RUN/'comparison.json').read_text())['rows'] if r['policy']=='ACT' and r['cohort']=='fresh_test']
+    seeds=list(range(2700000,4700000,100000));assert len(full)==len(pure)==20
+    state={'status':'starting','pid':os.getpid(),'started_at':datetime.datetime.now().astimezone().isoformat(),
+        'completed_cases':0,'retries':[],'hypothesis':HYPOTHESIS,'seeds':seeds,'steps_limit':800,
+        'model_retrained':False,'tuning_during_evaluation':False,'new_model_added':False,
+        'checkpoint_sha256':experiment['act_checkpoint_sha256'],
+        'source_hashes':{str(p.relative_to(ROOT)):sha(p) for p in sources},
+        'baseline_results_sha256':sha(RUN/'act_rgbd/results.json'),
+        'removed_component':'whole release branch, including release hold and its settle/replan',
+        'retained_components':'visual cube estimates, grasp alignment, grasp hold, cache reset, thresholds',
+        'primary_metric':'paired official stacking success at <=800 actions',
+        'secondary_metrics':'green sustained-lift proxy; final stack errors; intervention events',
+        'scope':'post-hoc component attribution on existing scenes, not independent new generalization test'}
+    save_json(GROUP/'protocol.json',state)
+    def progress(status,**extra):
+        state.update(status=status,updated_at=datetime.datetime.now().astimezone().isoformat(),**extra)
+        save_json(GROUP/'progress.json',state)
+    def run_case(seed,steps,path):
+        path.mkdir(parents=True,exist_ok=False)
+        with (path/'eval.log').open('x') as log:
+            return subprocess.run([sys.executable,'-u',str(scripts/'evaluate_act_ablation.py'),
+                '--seed',str(seed),'--steps',str(steps),'--output',str(path)],cwd=ROOT,
+                stdout=log,stderr=subprocess.STDOUT,timeout=1800)
+    def prefix_check(row,baseline):
+        bp=Path(baseline['result_path']).parent;ap=Path(row['result_path']).parent
+        events=[json.loads(x) for x in (bp/'visual_guard.jsonl').read_text().splitlines()]
+        release=[e['step'] for e in events if e.get('event') in ['aligned_release','align_before_release','release_blocked_missing_vision']]
+        until=min(release) if release else min(row['steps'],baseline['steps'])
+        actions=lambda p:np.asarray([json.loads(x)['action'] for x in (p/'trace.jsonl').read_text().splitlines()])
+        a,b=actions(ap),actions(bp);assert len(a)>=until and len(b)>=until
+        error=float(np.max(np.abs(a[:until]-b[:until]))) if until else 0.
+        assert error<=1e-5,f'Unexpected pre-release divergence {error}'
+        return {'matched_action_prefix_steps':until,'prefix_max_command_difference':error}
+    try:
+        ckpt=Path(experiment['act_checkpoint'])/'policy_last.ckpt'
+        assert sha(ckpt)==state['checkpoint_sha256']
+        progress('wiring_smoke')
+        smoke=run_case(200000,2,GROUP/'wiring-smoke');assert smoke.returncode==0
+        assert json.loads((GROUP/'wiring-smoke/result.json').read_text())['release_alignment'] is False
+        rows=[]
+        for seed in seeds:
+            for rel,h in state['source_hashes'].items():assert sha(ROOT/rel)==h,f'Frozen source changed: {rel}'
+            assert sha(ckpt)==state['checkpoint_sha256']
+            assert sha(RUN/'act_rgbd/results.json')==state['baseline_results_sha256']
+            for attempt in range(1,4):
+                case=GROUP/f'ACT_GRASP_ONLY-seed{seed}-attempt{attempt}'
+                progress('evaluating',current_seed=seed,current_attempt=attempt,completed_cases=len(rows))
+                execution=run_case(seed,800,case)
+                if execution.returncode==0:
+                    row=json.loads((case/'result.json').read_text())
+                    assert row['valid'] and row['actual_seed']==seed and row['release_alignment'] is False
+                    baseline=next(r for r in full if r['seed']==seed)
+                    control=next(r for r in pure if r['seed']==seed)
+                    assert row['initial']==baseline['initial']==control['initial']
+                    row.update(cohort='fresh_test',result_path=str(case/'result.json'))
+                    row.update(prefix_check(row,baseline));row['diagnostic']=diagnostic(row)
+                    events=[json.loads(x) for x in (case/'visual_guard.jsonl').read_text().splitlines()]
+                    assert not any(e.get('event') in ['aligned_release','align_before_release','release_blocked_missing_vision'] for e in events)
+                    row['guard_event_counts']={name:sum(e.get('event')==name for e in events) for name in ['align_open','aligned_close','settle_closed']}
+                    rows.append(row);save_json(GROUP/'results.partial.json',rows)
+                    progress('evaluating',completed_cases=len(rows),successes=sum(r['success'] for r in rows));break
+                state['retries'].append({'seed':seed,'attempt':attempt,'returncode':execution.returncode,'log':str(case/'eval.log')})
+                progress('evaluating')
+                if execution.returncode not in [-signal.SIGSEGV,-signal.SIGABRT]:raise RuntimeError(f'Invalid evaluation at {seed}: {execution.returncode}')
+            else:raise RuntimeError(f'Three native crashes at {seed}')
+        summaries={};pairs={}
+        for policy,cases in [('ACT',pure),('ACT_GRASP_ONLY',rows),('ACT_RGBD',full)]:
+            ds=[diagnostic(r) for r in cases]
+            summaries[policy]={'valid_cases':20,'successes':sum(r['success'] for r in cases),
+                'green_sustained_lift_proxy':sum(d['green_sustained_lift_proxy'] for d in ds),
+                'red_sustained_lift_proxy':sum(d['red_sustained_lift_proxy'] for d in ds),
+                'median_final_xy_cm':float(np.median([d['final_stack_xy_error_cm'] for d in ds])),
+                'corrected_steps':sum(r.get('corrected_steps',0) for r in cases),'replans':sum(r.get('replans',0) for r in cases)}
+        for seed in seeds:
+            a=next(r for r in rows if r['seed']==seed);b=next(r for r in full if r['seed']==seed)
+            key=f"FULL_{int(b['success'])}_NO_RELEASE_{int(a['success'])}";pairs[key]=pairs.get(key,0)+1
+        result={'status':'completed','hypothesis':HYPOTHESIS,'summaries':summaries,'paired_outcomes':pairs,
+            'rows':rows,'protocol':state,'baseline_rows':full,'pure_rows':pure}
+        save_json(GROUP/'results.json',result)
+        lines=['# ACT 释放纠偏消融报告','',
+            '假设：在抓取前对齐已经保留的条件下，释放前的几何对齐与释放控制分支能进一步提高堆叠成功率。此实验不增加第三种模型，不重新训练 ACT。','',
+            '## 配对结果','', '| 组别 | 官方成功数 | 红块持续抬升代理 | 绿块持续抬升代理 | 最终 XY 误差中位数 cm | 改写动作步数 | 重新预测次数 |',
+            '| --- | --- | --- | --- | --- | --- | --- |']
+        for p,s in summaries.items():lines.append(f"| {p} | {s['successes']}/20 | {s['red_sustained_lift_proxy']}/20 | {s['green_sustained_lift_proxy']}/20 | {s['median_final_xy_cm']:.2f} | {s['corrected_steps']} | {s['replans']} |")
+        lines+=['','完整纠偏与关闭释放纠偏的配对计数：'+json.dumps(pairs,ensure_ascii=False),
+            '', '## 比较条件与解释边界','',
+            '唯一代码差异是禁用整个释放对齐分支，包括该分支的阻止提前打开、几何对齐、释放后的保持和关联重新预测。其余抓取对齐、深度估计、阈值、ACT 权重与 50 步缓存配置不变。该实验隔离释放分支整体贡献，不分别识别其中几何纠偏、等待释放和重新预测的贡献，也不是 ACT 网络训练修复的消融。',
+            '', '三组使用相同的 20 个种子 2700000 至 4600000，间隔 100000，初始位姿逐场一致，每场最多 800 步；纯 ACT 与完整纠偏复用已完成的正式结果，不混入其他种子上的历史 95%。校验第一次释放介入之前的动作前缀，确认此前控制行为一致。',
+            '', '这是在已经看过的场景上的事后组件归因，不是新的独立泛化测试。只有一个训练种子和 20 个场景，不能将观察到的贡献推广为算法排名。若消融未降分，应如实认为本轮未显示额外成功率贡献，而非继续调参直到得到预期结果。',
+            '', '持续抬升代理并非经过验证的抓取成功；官方成功未额外验证长期稳定性。深度只进入控制器，方块真值只用于事后评分，不进入控制决策。原生崩溃尝试单独保留并同种子重试，不计任务失败。']
+        (RUN/'ACT_ABLATION.md').write_text('\n'.join(lines)+'\n')
+        progress('completed',completed_cases=20,summaries=summaries,paired_outcomes=pairs,report=str(RUN/'ACT_ABLATION.md'))
+    except Exception as error:
+        progress('failed',error=str(error),traceback=traceback.format_exc());raise
+
+if __name__=='__main__':
+    if '--detach' in sys.argv:
+        GROUP.mkdir(exist_ok=True)
+        with (GROUP/'coordinator.log').open('x') as log:
+            proc=subprocess.Popen([sys.executable,'-u',__file__],cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
+        print('ACT release ablation launched:',proc.pid)
+    else:main()
