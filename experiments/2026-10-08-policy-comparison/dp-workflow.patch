+"""2000 episodic epochs, matching the existing ACT's 80000-update budget."""
+import argparse
+import copy
+import json
+import math
+import time
+import os
+import random
+from pathlib import Path
+from common import CONFIG, Episodes, build_policy, save_json, torch, np
+from diffusion_policy.model.diffusion.ema_model import EMAModel
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--preflight', action='store_true')
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+    torch.set_num_threads(4)
+    torch.manual_seed(0); np.random.seed(0); random.seed(0)
+    assert torch.cuda.is_available() and torch.cuda.is_bf16_supported()
+    config = copy.deepcopy(CONFIG)
+    dataset = Episodes(config)
+    model = build_policy(config)
+    model.set_normalizer(dataset.normalizer())
+    model.cuda()
+    model.train()
+    ema_model = copy.deepcopy(model)
+    ema = EMAModel(ema_model, power=0.75)
+    optimizer = torch.optim.AdamW(model.parameters(), lr=config['lr'], betas=(0.95, 0.999), weight_decay=config['weight_decay'])
+    batch, center = dataset.sample(dataset.train[0])
+    begin = time.monotonic()
+    with torch.autocast('cuda', dtype=torch.bfloat16):
+        loss = model.compute_loss(batch)
+    assert torch.isfinite(loss)
+    loss.backward()
+    finite_grad = all(torch.isfinite(p.grad).all().item() for p in model.parameters() if p.grad is not None)
+    assert finite_grad
+    optimizer.step(); optimizer.zero_grad(set_to_none=True); ema.step(model)
+    with torch.inference_mode(), torch.autocast('cuda', dtype=torch.bfloat16):
+        predicted = ema_model.predict_action(batch['obs'])['action']
+    assert predicted.shape == (1, 8, 14) and torch.isfinite(predicted).all()
+    preflight = {'status': 'passed', 'parameters': sum(p.numel() for p in model.parameters()),
+        'loss': loss.item(), 'finite_gradients': finite_grad, 'prediction_shape': list(predicted.shape),
+        'peak_cuda_reserved_bytes': torch.cuda.max_memory_reserved(), 'elapsed_seconds': time.monotonic()-begin,
+        'input_keys': list(batch['obs']), 'center': center, 'train_episodes': dataset.train, 'validation_episodes': dataset.val}
+    save_json(args.output / 'preflight.json', preflight)
+    print(json.dumps(preflight), flush=True)
+    if args.preflight:
+        return
+    # Preflight is a separate invocation: never count it as a training update.
+    raise RuntimeError('Run with --preflight or use training_main() via --train entry')
+
+def training_main(output):
+    output.mkdir(parents=True, exist_ok=True)
+    torch.set_num_threads(4); torch.manual_seed(0); np.random.seed(0); random.seed(0)
+    config = copy.deepcopy(CONFIG)
+    dataset = Episodes(config)
+    model = build_policy(config)
+    model.set_normalizer(dataset.normalizer()); model.cuda(); model.train()
+    ema_model = copy.deepcopy(model)
+    ema = EMAModel(ema_model, power=0.75)
+    optimizer = torch.optim.AdamW(model.parameters(), lr=config['lr'], betas=(0.95, 0.999), weight_decay=config['weight_decay'])
+    save_json(output / 'config.json', config)
+    start = time.monotonic(); updates = 0
+    # Fixed validation locations and independent noise seed, not test-scene tuning.
+    val_points = [(ep, int(dataset.lengths[ep] * fraction)) for ep in dataset.val for fraction in (0.15, 0.5, 0.85)]
+    with (output / 'metrics.jsonl').open('x', buffering=1) as log:
+        for epoch in range(1, config['epochs'] + 1):
+            losses = []
+            for ep in dataset.rng.permutation(dataset.train):
+                batch, _ = dataset.sample(int(ep))
+                progress = updates / (config['epochs'] * 40)
+                warmup = min(1.0, (updates + 1) / 500)
+                lr = config['lr'] * warmup * (0.5 + 0.5 * math.cos(math.pi * progress))
+                for group in optimizer.param_groups: group['lr'] = lr
+                with torch.autocast('cuda', dtype=torch.bfloat16): loss = model.compute_loss(batch)
+                if not torch.isfinite(loss): raise RuntimeError(f'Non-finite loss at {epoch}:{updates}')
+                loss.backward()
+                grad = torch.nn.utils.clip_grad_norm_(model.parameters(), 10.0, error_if_nonfinite=True)
+                optimizer.step(); optimizer.zero_grad(set_to_none=True); ema.step(model)
+                losses.append(loss.item()); updates += 1
+            row = {'epoch': epoch, 'optimizer_steps': updates, 'train_noise_mse': float(np.mean(losses)),
+                   'lr': lr, 'last_gradient_norm': float(grad), 'elapsed_seconds': time.monotonic()-start,
+                   'peak_cuda_reserved_bytes': torch.cuda.max_memory_reserved()}
+            if epoch == 1 or epoch % 20 == 0:
+                val_losses = []
+                with torch.random.fork_rng(devices=[0]):
+                    torch.manual_seed(12345)
+                    with torch.inference_mode(), torch.autocast('cuda', dtype=torch.bfloat16):
+                        for ep, center in val_points:
+                            sample, _ = dataset.sample(ep, center, critical=False)
+                            val_losses.append(ema_model.compute_loss(sample).item())
+                row['validation_ema_noise_mse'] = float(np.mean(val_losses))
+            log.write(json.dumps(row)+'\n')
+            save_json(output / 'progress.json', {'status': 'training', 'pid': os.getpid(), **row})
+            if epoch == 1 or epoch % 20 == 0: print(json.dumps(row), flush=True)
+            if epoch % 200 == 0:
+                payload = {'config': config, 'epoch': epoch, 'optimizer_steps': updates,
+                           'model': model.state_dict(), 'ema': ema_model.state_dict()}
+                tmp = output / 'latest.pt.tmp'; torch.save(payload, tmp); tmp.replace(output / 'latest.pt')
+                if epoch == config['epochs']:
+                    tmp = output / '2000.pt.tmp'; torch.save(payload, tmp); tmp.replace(output / '2000.pt')
+    assert updates == 80000
+    save_json(output / 'progress.json', {'status': 'completed', **row})
+
+if __name__ == '__main__':
+    import sys
+    if '--train' in sys.argv:
+        sys.argv.remove('--train')
+        parser = argparse.ArgumentParser(); parser.add_argument('--output', type=Path, required=True)
+        training_main(parser.parse_args().output)
+    else:
+        main()
