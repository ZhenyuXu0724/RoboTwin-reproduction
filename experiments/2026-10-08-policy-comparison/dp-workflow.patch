+"""Launch the complete requested workflow as a detached, logged process."""
+import subprocess
+import os
+import sys
+import argparse
+from pathlib import Path
+from common import ROOT, save_json
+
+parser=argparse.ArgumentParser()
+parser.add_argument('--output', type=Path, default=ROOT/'data/dp_compare_20261007/run2000_v2')
+output=parser.parse_args().output.resolve()
+output.mkdir(parents=True,exist_ok=True)
+if (output/'launch.json').exists(): raise RuntimeError('Already launched; inspect status rather than start twice')
+with (output/'pipeline.log').open('x') as log:
+    process=subprocess.Popen([sys.executable,'-u',str(Path(__file__).parent/'pipeline.py'),'--output',str(output)],
