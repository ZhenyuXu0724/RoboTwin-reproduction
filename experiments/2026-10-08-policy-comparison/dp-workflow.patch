+import unittest
+from common import CONFIG, Episodes, load_split, sequence_indices, torch, np
+
+class Contracts(unittest.TestCase):
+    def test_split(self):
+        train, val = load_split()
+        self.assertEqual((len(train),len(val)),(40,10))
+        self.assertFalse(set(train)&set(val))
+    def test_start_padding_and_alignment(self):
+        obs, action = sequence_indices(0,100,CONFIG)
+        self.assertEqual(obs.tolist(),[0,0])
+        self.assertEqual(action[:3].tolist(),[0,0,1])
+    def test_middle_no_future_observation(self):
+        obs, action = sequence_indices(50,100,CONFIG)
+        self.assertEqual(obs.tolist(),[49,50])
+        self.assertEqual(action[CONFIG['n_obs_steps']-1],50)
+        self.assertEqual(action[-1],64)
+    def test_end_padding(self):
+        obs, action = sequence_indices(99,100,CONFIG)
+        self.assertEqual(obs.tolist(),[98,99])
+        self.assertTrue(np.all(action[1:]==99))
+    def test_cpu_rgb_sample(self):
+        dataset=Episodes(); batch,_=dataset.sample(0,0,device='cpu')
+        self.assertEqual(set(batch['obs']),{'agent_pos','cam_head','cam_left_wrist','cam_right_wrist'})
+        self.assertEqual(tuple(batch['action'].shape),(1,16,14))
+        rgb=batch['obs']['cam_head']
+        self.assertEqual(tuple(rgb.shape),(1,2,3,480,640))
+        self.assertTrue(torch.equal(rgb[:,0],rgb[:,1]))
+        self.assertGreaterEqual(rgb.min().item(),0)
+        self.assertLessEqual(rgb.max().item(),1)
+        self.assertTrue(np.array_equal(batch['action'][0,1].numpy(),dataset.actions[0][0]))
+
+if __name__=='__main__': unittest.main()
