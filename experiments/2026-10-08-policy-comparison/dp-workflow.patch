+OUT=ROOT/'data/dp_compare_20261007/run2000_v2/diagnosis_20261008'
+result=json.loads((OUT/'results.json').read_text())
+rows=[json.loads(x) for x in (OUT/'points.jsonl').read_text().splitlines()]
+pred=np.load(OUT/'predictions.npz')['action_pred'][:,1:9]
+data=Episodes();joints=[j for j in range(14) if j not in (6,13)]
+summary={}
+for split in ['train','validation']:
+    ids=[i for i,r in enumerate(rows) if r['split']==split]
+    targets=np.stack([data.actions[rows[i]['episode']][np.clip(np.arange(rows[i]['center'],rows[i]['center']+8),0,data.lengths[rows[i]['episode']]-1)] for i in ids])
+    states=np.stack([data.states[rows[i]['episode']][rows[i]['center']] for i in ids])
+    err=np.abs(pred[ids]-targets);hold=np.abs(states[:,None]-targets)
+    events=[e for i in ids for e in rows[i]['events_in_chunk']]
+    summary[split]={'joint_mae_by_chunk_offset_rad':err[:,:,joints].mean(axis=(0,2)).tolist(),
+        'hold_joint_mae_by_chunk_offset_rad':hold[:,:,joints].mean(axis=(0,2)).tolist(),
+        'gripper_mae_by_chunk_offset':err[:,:,[6,13]].mean(axis=(0,2)).tolist(),
+        'events_in_chunks':len(events),'missing_desired_binary_state':sum(e['timing_error_frames'] is None for e in events),
+        'early':sum(e['timing_error_frames'] is not None and e['timing_error_frames']<0 for e in events),
+        'on_time':sum(e['timing_error_frames']==0 for e in events),
+        'late':sum(e['timing_error_frames'] is not None and e['timing_error_frames']>0 for e in events),
+        'median_timing_error_present_frames':float(np.median([e['timing_error_frames'] for e in events if e['timing_error_frames'] is not None]))}
+repeats=result['noise_repeats']
+summary['noise_repeats']={'observations':len(repeats),'draws_each':4,
+    'joint_std_mean_rad':float(np.mean([x['joint_std_rad'] for x in repeats])),
+    'gripper_std_mean':float(np.mean([x['gripper_std'] for x in repeats]))}
+execution=OUT/'closed_loop_seed2700000/execution.jsonl'
+if execution.exists():
+    r=[json.loads(x) for x in execution.read_text().splitlines()]
+    before=np.asarray([x['before'] for x in r]);after=np.asarray([x['after'] for x in r]);commands=np.asarray([x['command'] for x in r])
+    inputs=np.asarray([x['policy_input_target_state'] for x in r]);close_events=[]
+    for j,side in [(6,'left'),(13,'right')]:
+        for i in np.flatnonzero((commands[1:,j]<=.2)&(commands[:-1,j]>.2))+1:
+            step=r[i];tcp=np.asarray(step['tcp_before_for_diagnosis_only'][side]);red=np.asarray(step['cube_before_for_diagnosis_only']['red'])
+            close_events.append({'step':step['step'],'side':side,'tcp_to_red_center_cm':float(np.linalg.norm(tcp-red)*100),
+                'tcp_to_red_approach_target_cm':float(np.linalg.norm(tcp-red-np.array([0,0,.0106]))*100)})
+    lengths=[x['planner'][side]['interpolation_samples'] for x in r for side in x['planner']]
+    durations=[x['planner'][side]['reported_duration'] for x in r for side in x['planner']]
+    summary['execution']={'actions':len(r),'before_command_joint_mae_rad':float(np.abs(before[:,joints]-commands[:,joints]).mean()),
+        'after_command_joint_mae_rad':float(np.abs(after[:,joints]-commands[:,joints]).mean()),
+        'input_target_vs_actual_joint_mae_rad':float(np.abs(inputs[:,joints]-before[:,joints]).mean()),
+        'after_command_gripper_mae':float(np.abs(after[:,[6,13]]-commands[:,[6,13]]).mean()),
+        'planner_samples_quantiles':np.quantile(lengths,[0,.5,.9,1]).tolist(),
