+"""Read-only audit of all local raw/processed trajectories and recorded rollouts."""
+from pathlib import Path
+import sys, json, hashlib, collections
+import numpy as np
+import h5py, cv2
+ROOT = Path('${ROBOTWIN_ROOT}')
