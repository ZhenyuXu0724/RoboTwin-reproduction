+    sep=np.abs(obj[:,1]-obj[:,0]-[0,0,.05]);geom=np.all(sep<[.025,.025,.012],axis=1)
+    row={'path':str(path.relative_to(ROOT)),'records':len(rs),'last_step':rs[-1].get('step'),'success':any(r.get('success',False) for r in rs),
+         'max_lift_cm':lift.max(0).tolist(),'frames_above_3cm':(lift>3).sum(0).tolist(),
+         'first_above_3cm':[next((rs[i].get('step') for i in range(len(rs)) if lift[i,j]>3),None) for j in range(2)],
+         'ever_stack_geometry':bool(geom.any()),'final_red_target_xy_cm':float(np.linalg.norm(obj[-1,0,:2]-[0,-.13])*100),
+         'initial_positions':obj[0].tolist(),'final_positions':obj[-1].tolist()}
