+from XPolicyLab.utils.process_data import decode_image_bit
+OUT = Path(__file__).parent
+CAMS = ['cam_head','cam_right_wrist','cam_left_wrist']
+def dump(name, obj):
+    (OUT/name).write_text(json.dumps(obj, indent=2, ensure_ascii=False)+'\n')
+def packed(f, kind):
+    return np.concatenate([f[f'{kind}/{s}_{p}_joint_states'][:] for s in ['left','right'] for p in ['arm','ee']], axis=1)
+rows=[]; decoded_cache={}
+for path in sorted((ROOT/'data').rglob('*.hdf5')):
+    row={'path':str(path.relative_to(ROOT)), 'errors':[]}
+    try:
+        with h5py.File(path,'r') as f:
+            q,a=packed(f,'state'),packed(f,'action');n=len(a)
+            row.update(length=n,action_dim=a.shape[1],trajectory_sha256=hashlib.sha256(q.tobytes()+a.tobytes()).hexdigest(),
+                       finite=bool(np.isfinite(q).all() and np.isfinite(a).all()),
+                       action_next_state_max_error=float(np.abs(a[:-1]-q[1:]).max()),
+                       frequency=int(f['additional_info/frequency'][()]) if 'additional_info/frequency' in f else None,
+                       gripper_range=[float(a[:,[6,13]].min()),float(a[:,[6,13]].max())])
+            bad_numeric=[]
+            def check_numeric(k,v):
+                if isinstance(v,h5py.Dataset) and v.dtype.kind in 'fci' and not np.isfinite(v[: ] if v.shape else v[()]).all(): bad_numeric.append(k)
+            f.visititems(check_numeric);row['nonfinite_numeric_datasets']=bad_numeric
+            events=sorted([{'t':int(t),'arm':s} for s,j in [('L',6),('R',13)] for t in np.where((a[:-1,j]>.5)&(a[1:,j]<=.5))[0]+1],key=lambda e:e['t'])
+            row['closure_events']=events;row['mode']=''.join(e['arm'] for e in events)
+            digest=row['trajectory_sha256'];is_stack='stack_blocks_two' in str(path)
+            # Full decode for unique stacking trajectories; three samples/camera for the unrelated hammer task.
+            if digest not in decoded_cache:
+                count=0;shapes=set()
+                for cam in f['vision']:
+                    ds=f[f'vision/{cam}/colors'];assert len(ds)==n
+                    ts=range(n) if is_stack else sorted(set([0,n//2,n-1]))
+                    for t in ts:
+                        img=decode_image_bit(ds[t]);assert img.ndim==3 and img.shape[-1]==3
+                        shapes.add(tuple(img.shape));count+=1
+                decoded_cache[digest]={'images_decoded':count,'image_shapes':sorted(shapes),'full_decode':is_stack,'decoded_from':row['path']}
+            row['image_check']=decoded_cache[digest]
+            bench=path.relative_to(ROOT/'data').parts[0];ep=int(path.stem.split('_')[-1])
+            proc=ROOT/f'XPolicyLab/policy/ACT/processed_data/{bench}/stack_blocks_two/aloha_agilex-joint/episode_{ep}.hdf5'
+            if is_stack and '/staging/' not in str(path) and proc.exists():
+                with h5py.File(proc) as p:
+                    assert np.array_equal(p['action'][:],a) and np.array_equal(p['observations/qpos'][:],q)
+                    row['action_start_offset']=int(p.attrs.get('action_start_offset',-999))
+                    row['sim']=bool(p.attrs.get('sim',False));err=0;cnt=0
+                    for cam in CAMS:
+                        ds=p[f'observations/images/{cam}'];assert ds.shape==(n,480,640,3)
+                        for t in sorted(set([0,n//2,n-1]+[max(0,e['t']-5) for e in events])):
+                            rgb=cv2.resize(decode_image_bit(f[f'vision/{cam}/colors'][t]),(640,480))
+                            err=max(err,int(np.abs(rgb.astype(int)-ds[t].astype(int)).max()));cnt+=1
+                    row.update(processed_images_checked=cnt,processed_rgb_max_error=err,processed_numeric_equal=True)
+            row['max_arm_increment_deg']=float(np.abs(np.diff(a[:,[0,1,2,3,4,5,7,8,9,10,11,12]],axis=0)).max()*180/np.pi)
+    except Exception as e:row['errors'].append(repr(e))
+    rows.append(row)
+    if len(rows)%10==0:print('RAW',len(rows),flush=True)
