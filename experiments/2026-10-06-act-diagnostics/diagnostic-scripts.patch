+"""CPU, strict checkpoint load; fixed expert observations at closure -10 and 0."""
+from pathlib import Path
+import sys,os,json,pickle,time
+from argparse import Namespace
+import numpy as np,h5py,torch,yaml
+R=Path('${ROBOTWIN_ROOT}');sys.path.insert(0,str(R));O=Path(__file__).parent
+os.environ['TORCH_HOME']=str(R/'data/model_cache/torch');os.environ['ACT_ACTION_DIM']='14'
+torch.set_num_threads(4);torch.manual_seed(0)
+from XPolicyLab.policy.ACT.detr.models import build_ACT_model
+configs=[R/'data/demo_train20/diagnose4000_20261004/act_eval_config.yml',R/'data/demo_train50/train2000_20261004_171920/evaluation/act_eval_config.yml']
+audit=json.loads((O/'trajectory_audit.json').read_text())['rows'];results=[]
+mean=torch.tensor([.485,.456,.406]).reshape(1,1,3,1,1);std=torch.tensor([.229,.224,.225]).reshape(1,1,3,1,1)
+for config in configs:
+    cfg=yaml.safe_load(config.read_text());ckpt=Path(cfg['ckpt_dir']);tc=json.loads((ckpt/'training_config.json').read_text());bench=tc['ckpt_setting'].split('-')[0]
+    model=build_ACT_model(Namespace(**cfg));weights=torch.load(ckpt/'policy_last.ckpt',map_location='cpu',weights_only=True)
+    model.load_state_dict({k.removeprefix('model.'):v for k,v in weights.items()},strict=True);model.eval()
+    with open(ckpt/'dataset_stats.pkl','rb') as f:s=pickle.load(f)
+    episodes=[r for r in audit if r['path'].startswith('data/'+bench+'/stack_blocks_two/')]
+    start=time.monotonic()
+    for ep in episodes:
+        i=int(Path(ep['path']).stem.split('_')[-1]);split='train' if i in tc['train_episode_ids'] else 'validation'
+        with h5py.File(Path(tc['dataset_dir'])/f'episode_{i}.hdf5') as f:
+            for color,event in zip(['red','green'],ep['closure_events']):
+                j=0 if event['arm']=='L' else 7
+                for offset in [-10,0]:
+                    t=event['t']+offset
+                    ims=np.stack([f['observations/images/'+cam][t] for cam in cfg['camera_names']])
+                    im=torch.from_numpy(np.ascontiguousarray(ims.transpose(0,3,1,2))).float()[None]/255
+                    q=torch.from_numpy((f['observations/qpos'][t]-s['qpos_mean'])/s['qpos_std']).float()[None]
+                    with torch.inference_mode():pred=model(q,(im-mean)/std,None)[0][0].numpy()
