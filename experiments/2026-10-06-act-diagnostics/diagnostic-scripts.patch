+"""Run training, strict checkpoint validation, and five matched unseen rollouts."""
+from pathlib import Path
+import json,os,subprocess,sys,datetime
+out=Path(__file__).parent;root=Path('${ROBOTWIN_ROOT}');python=sys.executable
+manifest=out/'experiment.json';m=json.loads(manifest.read_text());ckpt=Path(m['checkpoint_dir'])
+def phase(value,**extra):
+ m.update(phase=value,updated_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),**extra)
+ temp=manifest.with_suffix('.json.tmp');temp.write_text(json.dumps(m,indent=2));temp.replace(manifest)
+def run(command,log,cwd):
+ with log.open('w') as f:subprocess.run(command,cwd=cwd,stdout=f,stderr=subprocess.STDOUT,check=True)
+os.environ.update(CUDA_VISIBLE_DEVICES='0',TORCH_HOME=str(root/'data/model_cache/torch'),MPLCONFIGDIR='/tmp/robotwin-matplotlib',ROBOTWIN_RAY_TRACING_DENOISER='none',PYTHONUNBUFFERED='1')
+os.environ['ACT_ACTION_DIM']=subprocess.check_output(['bash',str(root/'XPolicyLab/utils/get_action_dim.sh'),str(root),'aloha_agilex'],text=True).strip()
+try:
+ phase('training')
+ run([python]+m['training_command'],ckpt/'train.log',root/'XPolicyLab/policy/ACT')
+ metrics=[json.loads(line) for line in (ckpt/'training_metrics.jsonl').read_text().splitlines()]
+ assert len(metrics)==2000 and metrics[-1]['epoch']==4000 and metrics[-1]['optimizer_steps']==160000
+ phase('checkpoint_validation',training_elapsed_seconds=metrics[-1]['elapsed_seconds'])
+ run([python,str(root/'scripts/validate_act_checkpoint.py'),'--ckpt-dir',str(ckpt),'--env-cfg-type','aloha_agilex','--action-type','joint'],out/'checkpoint_validation.log',root)
+ phase('evaluating')
+ run([python,str(out/'evaluation/run_isolated.py')],out/'evaluation/launcher.log',root)
+ run([python,str(out/'evaluation/analyze_completed.py')],out/'evaluation/analysis.log',root)
+ results=json.loads((out/'evaluation/results.json').read_text())
+ run([python,str(out/'compare_results.py')],out/'comparison.log',root)
+ phase('completed' if results['completed_cases']==5 else 'evaluation_incomplete',evaluation_results=str(out/'evaluation/results.json'),completed_evaluation_cases=results['completed_cases'],successes=results['successes'])
+except Exception as error:
+ phase('failed',error=str(error));raise
