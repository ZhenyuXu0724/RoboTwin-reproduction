+rows=[];initial=[]
+for epoch in [4000]:
+ policy.load_state_dict(torch.load(ckpt/f'policy_epoch_{epoch}_seed_0.ckpt',map_location='cuda:0',weights_only=True));policy.eval()
+ for ep in range(20):
+  split='train' if ep in c['train_episode_ids'] else 'validation'
+  with h5py.File(Path(c['dataset_dir'])/f'episode_{ep}.hdf5') as f:
+   action=f['action'][:];state=f['observations/qpos'][:]
+   ids=list(np.linspace(0,len(action)-50,8,dtype=int))
+   for g in grippers:
+    closing=np.where((action[:-1,g]>.5)&(action[1:,g]<=.5))[0]
+    ids.extend(int(max(0,min(len(action)-50,t-5))) for t in closing)
+   for t in sorted(set(ids)):
+    im=np.stack([f['observations/images/'+cam][t] for cam in c['camera_names']])
+    image=torch.from_numpy(np.ascontiguousarray(im.transpose(0,3,1,2))).float().div(255).unsqueeze(0).cuda()
+    q=torch.from_numpy(((state[t]-stats['qpos_mean'])/stats['qpos_std']).astype('float32')).unsqueeze(0).cuda()
+    target=(action[t:t+50]-stats['action_mean'])/stats['action_std']
