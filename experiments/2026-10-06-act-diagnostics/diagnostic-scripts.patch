+from pathlib import Path
+import json
+import numpy as np
+import matplotlib
+matplotlib.use('Agg')
+import matplotlib.pyplot as plt
+out=Path(__file__).parent
+manifest=json.loads((out/'experiment.json').read_text())
+rows=[]
+for key in ['source_checkpoint_dir','checkpoint_dir']:
+ rows += [json.loads(x) for x in (Path(manifest[key])/'training_metrics.jsonl').read_text().splitlines()]
+fig,ax=plt.subplots(figsize=(10,4.8),layout='constrained')
+for key,label,color in [('train','Training','#2166ac'),('validation_before_epoch','Validation (sampled frames)','#d6604d')]:
+ x=np.array([r['epoch'] for r in rows]);y=np.array([r[key]['l1'] for r in rows])
+ ax.plot(x,y,alpha=.12,color=color,lw=.5)
+ for low,high in [(1,2000),(2001,4000)]:
+  take=(x>=low)&(x<=high);xs=x[take];ys=y[take]
+  if len(xs)>=100:ax.plot(xs[99:],np.convolve(ys,np.ones(100)/100,mode='valid'),color=color,lw=2,label=label if low==1 else None)
+ax.axvline(2000,color='#555555',ls='--',lw=1)
+ax.text(2040,.39,'Warm start\noptimizer reset',fontsize=9,color='#555555')
+ax.set(xlabel='Cumulative epoch',ylabel='Normalized L1',title='ACT: same 20 episodes (16 training / 4 validation)',ylim=(0,.5),xlim=(0,4000))
+ax.legend(title='Lines: 100-epoch mean',frameon=False)
+ax.grid(alpha=.15)
+fig.savefig(out/'training_curve.png',dpi=160)
+plt.close(fig)
