+#!/usr/bin/env bash
+set -euo pipefail
+
+source ${USER_HOME}/anaconda3/etc/profile.d/conda.sh
+conda activate RoboTwin
+cd ${ROBOTWIN_ROOT}
+
+export CUDA_VISIBLE_DEVICES=0
+export TORCH_HOME=${ROBOTWIN_ROOT}/data/model_cache/torch
+export MPLCONFIGDIR=/tmp/robotwin-matplotlib
+export ROBOTWIN_RAY_TRACING_DENOISER=none
+export PYTHONUNBUFFERED=1
+ACT_ACTION_DIM=$(python -c 'from XPolicyLab.utils.process_data import get_action_dim; print(get_action_dim("aloha_agilex"))')
+export ACT_ACTION_DIM
+
+policy_port=$(bash XPolicyLab/utils/get_free_port.sh)
+server_pid=""
+cleanup() {
+    if [[ -n "$server_pid" ]]; then
+        kill "$server_pid" 2>/dev/null || true
+        wait "$server_pid" 2>/dev/null || true
+    fi
+}
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+
+python XPolicyLab/setup_policy_server.py \
+    --config_path data/demo_train50/train4000_20261004_232142/evaluation/act_eval_config.yml \
+    --host 127.0.0.1 --port "$policy_port" \
+    > data/demo_train50/train4000_20261004_232142/evaluation/act_eval_server.log 2>&1 &
+server_pid=$!
+printf '%s\n' "$server_pid" > data/demo_train50/train4000_20261004_232142/evaluation/act_eval_server.pid
+bash XPolicyLab/utils/wait_for_policy_server.sh \
+    127.0.0.1 "$policy_port" "$server_pid" ACT 120
+
+python ${ROBOTWIN_ROOT}/data/demo_train50/train4000_20261004_232142/evaluation/trace_eval.py \
+    --bench_name demo_train50 \
+    --task_name stack_blocks_two \
+    --env_cfg_type aloha_agilex \
+    --policy_name ACT \
+    --host 127.0.0.1 --port "$policy_port" --protocol ws \
+    --eval_batch false \
+    --root_dir ${ROBOTWIN_ROOT} --device_id 0 \
+    --task_config demo_smoke --test_num 5 --seed 1 \
+    --expert_check true --instruction_type seen \
+    --additional_info 'ckpt_name=demo_train50-stack_blocks_two-aloha_agilex-joint-0-warm4000-20261004_232142,action_type=joint' \
+    > data/demo_train50/train4000_20261004_232142/evaluation/act_eval_client.log 2>&1
+tail -c 1600 data/demo_train50/train4000_20261004_232142/evaluation/act_eval_client.log
