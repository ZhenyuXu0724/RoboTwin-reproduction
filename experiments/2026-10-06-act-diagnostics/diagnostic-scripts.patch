+"""Summarize completed rollouts only; retain interrupted attempts separately."""
+from pathlib import Path
+import json, re, subprocess
+import numpy as np
+import cv2
+from PIL import Image, ImageDraw
+root=Path('${ROBOTWIN_ROOT}')
+out=Path(__file__).parent
+status_path=out/'isolated_status.json'
+status=json.loads(status_path.read_text()) if status_path.exists() else []
+results=[]
+for case in status:
+    if not case.get('complete'):
+        continue
+    d=Path(case['result_directory'])
+    text=re.sub(r'\x1b\[[0-9;]*m','',(d/'act_eval_client.log').read_text())
+    seed=int(re.search(r'current seed: (\d+)',text).group(1))
+    result=root/re.search(r'Data has been saved to (.+/_result.txt)',text).group(1)
+    video=result.with_name('episode0.mp4')
+    records=[json.loads(line) for line in (d/'object_trace.jsonl').read_text().splitlines()]
+    steps=records[-1]['step']
+    assert [r['step'] for r in records]==list(range(steps+1))
+    assert case['success'] or steps==800
+    p=np.array([[r['red'],r['green']] for r in records])
+    probe=json.loads(subprocess.check_output(['ffprobe','-v','error','-count_frames','-show_entries','stream=width,height,duration,nb_read_frames','-of','json',str(video)]))['streams'][0]
+    row={'case':case['seed_argument'],'scene_seed':seed,'success':case['success'],'steps':steps,'video':str(video),'video_metadata':probe,'red_max_height_increase_cm':float((p[:,0,2].max()-p[0,0,2])*100),'green_max_height_increase_cm':float((p[:,1,2].max()-p[0,1,2])*100),'red_final_xy_displacement_cm':float(np.linalg.norm(p[-1,0,:2]-p[0,0,:2])*100),'green_final_xy_displacement_cm':float(np.linalg.norm(p[-1,1,:2]-p[0,1,:2])*100),'red_min_target_xy_distance_cm':float(np.linalg.norm(p[:,0,:2]-[0,-.13],axis=1).min()*100),'initial_positions':p[0].tolist(),'final_positions':p[-1].tolist()}
+    results.append(row)
+    image_path=d/'video_frames.jpg'
+    if not image_path.exists():
+        count=int(probe['nb_read_frames'])
+        indices=sorted(set(min(x,count-1) for x in [0,40,80,120,160,200,250,300,400,500,600,count-1]))
+        sheet=Image.new('RGB',(960,264*4),'white');draw=ImageDraw.Draw(sheet)
+        cap=cv2.VideoCapture(str(video))
+        for i,n in enumerate(indices):
+            cap.set(cv2.CAP_PROP_POS_FRAMES,n);ok,frame=cap.read();assert ok
+            x=i%3*320;y=i//3*264
+            sheet.paste(Image.fromarray(cv2.cvtColor(frame,cv2.COLOR_BGR2RGB)),(x,y+24))
+            draw.text((x+6,y+6),f'Seed {seed} - frame {n}',fill='black')
+        cap.release();sheet.save(image_path)
+    print({k:round(v,2) if isinstance(v,float) else v for k,v in row.items() if k not in ('video_metadata','initial_positions','final_positions','video')})
+report={'planned_cases':5,'completed_cases':len(results),'successes':sum(r['success'] for r in results),'cases':results,'measurement_note':'Object position samples at action boundaries; height rise alone does not prove a secure grasp. Interrupted simulator attempts are not included as policy failures.'}
+(out/'results.json').write_text(json.dumps(report,indent=2)+'\n')
