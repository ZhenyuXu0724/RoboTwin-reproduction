+"""Read-only pose tracing around the unchanged evaluation action executor."""
+import faulthandler
+import json
+import runpy
+import sys
+from pathlib import Path
+
+root = Path('${ROBOTWIN_ROOT}')
+sys.path.insert(0, str(root))
+faulthandler.dump_traceback_later(180, repeat=True)
+from envs.stack_blocks_two import stack_blocks_two
+
+# Diagnostic: serialize camera rendering/readback while retaining the same
+# renderer, cameras, image conversion, policy and action execution.
+import numpy as np
+from envs.camera.camera import Camera
+original_get_rgba = Camera.get_rgba
+
+def serial_update_picture(self):
+    cameras = []
+    if self.collect_wrist_camera:
+        cameras.extend([('left_camera', self.left_camera), ('right_camera', self.right_camera)])
+    cameras.extend(zip(self.static_camera_name, self.static_camera_list))
+    cached = {}
+    for name, camera in cameras:
+        camera.take_picture()
+        rgba = camera.get_picture('Color')
+        if name != 'head_camera' or self.collect_head_camera:
+            cached[name] = {'rgba': (rgba * 255).clip(0, 255).astype('uint8')}
+    self._serial_rgba = cached
+    if not getattr(self, '_serial_verified', False):
+        reference = original_get_rgba(self)
+        assert reference.keys() == cached.keys()
+        assert all(np.array_equal(reference[k]['rgba'], cached[k]['rgba']) for k in reference)
+        self._serial_verified = True
+        print('SERIAL_CAMERA_CAPTURE: cached images exactly match original RGBA getter', flush=True)
+
+def cached_get_rgba(self):
+    cached = getattr(self, '_serial_rgba', None)
+    return original_get_rgba(self) if cached is None else cached
+
+Camera.update_picture = serial_update_picture
+Camera.get_rgba = cached_get_rgba
+
+original_take_action = stack_blocks_two.take_action
+trace = Path(__file__).with_name('object_trace.jsonl').open('x', buffering=1)
+def record(task, phase):
+    row = {
+        'episode': int(task.test_num),
+        'step': int(task.take_action_cnt),
+        'phase': phase,
+        'red': task.block1.get_pose().p.tolist(),
+        'green': task.block2.get_pose().p.tolist(),
+        'left_gripper_command': float(task.robot.get_left_gripper_val()),
+        'right_gripper_command': float(task.robot.get_right_gripper_val()),
+        'success': bool(task.eval_success),
+    }
+    trace.write(json.dumps(row) + '\n')
+def traced_take_action(self, action, action_type='qpos'):
+    if self.take_action_cnt == 0:
+        record(self, 'initial')
+    result = original_take_action(self, action, action_type=action_type)
+    record(self, 'after_action')
+    return result
+stack_blocks_two.take_action = traced_take_action
+import scripts.eval_policy_xpolicylab as evaluator
+original_eval = evaluator.eval_remote_policy
+def seed_zero(task_name, task_env, args, model_client, st_seed, **kwargs):
+    return original_eval(task_name, task_env, args, model_client, 0, **kwargs)
+evaluator.eval_remote_policy = seed_zero
+try:
+    evaluator.main(evaluator.parse_args())
+finally:
+    trace.close()
