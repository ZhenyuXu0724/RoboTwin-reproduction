+for r in rows:groups[r.get('trajectory_sha256',r['path'])].append(r['path'])
+dump('trajectory_audit.json',{'rows':rows,'raw_files':len(rows),'unique_state_action_trajectories':len(groups),'duplicate_groups':[v for v in groups.values() if len(v)>1], 'errors':[r for r in rows if r['errors']], 'scope':'Every raw file: all numeric arrays. Unique stacking state/action trajectories: every RGB frame decoded once; duplicates reuse this image check, not byte identity. Processed RGB checked at endpoints, midpoint and pre-closure frames only. Hammer RGB sampled.'})
+print('RAW COMPLETE',len(rows),'unique',len(groups),flush=True)
