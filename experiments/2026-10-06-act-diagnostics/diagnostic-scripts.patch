@@ -0,0 +1,15 @@
+"""Color-based diagnostics for known red/green boxes; not the ACT perception model."""
+import numpy as np,cv2
+def mask_color(rgb,color):
+    hsv=cv2.cvtColor(rgb,cv2.COLOR_RGB2HSV)
+    hue=hsv[:,:,0];sat=hsv[:,:,1];val=hsv[:,:,2]
+    hue_ok=((hue<12)|(hue>168)) if color=='red' else ((hue>35)&(hue<90))
+    return (hue_ok&(sat>110)&(val>45)).astype('uint8')
+def detect(rgb,color):
+    mask=mask_color(rgb,color);n,labels,stats,centroids=cv2.connectedComponentsWithStats(mask)
+    if n<=1:return {'pixels':0,'bbox':None,'centroid':None,'touches_border':False}
+    j=1+int(np.argmax(stats[1:,cv2.CC_STAT_AREA]));x,y,w,h,area=stats[j].tolist()
+    return {'pixels':area,'bbox':[x,y,x+w,y+h],'centroid':centroids[j].tolist(),'touches_border':bool(x==0 or y==0 or x+w==rgb.shape[1] or y+h==rgb.shape[0])}
+def project(point,K,E):
+    xyz=(E@np.r_[point[:3],1])[:3];p=K@xyz
+    return (p[:2]/p[2]).tolist() if xyz[2]>0 else None
