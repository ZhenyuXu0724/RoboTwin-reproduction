+training=[]
+for path in sorted((ROOT/'XPolicyLab/policy/ACT/checkpoints').glob('*/training_metrics.jsonl')):
+    rs=[json.loads(s) for s in path.read_text().splitlines() if s.strip()];tail=rs[-200:]
+    training.append({'run':path.parent.name,'epochs_recorded':len(rs),'last':rs[-1], 'last200_train_l1':float(np.mean([r['train']['l1'] for r in tail])), 'last200_val_l1':float(np.mean([r['validation_before_epoch']['l1'] for r in tail])), 'last200_kl':float(np.mean([r['train']['kl'] for r in tail])), 'finite':all(np.isfinite(r['train']['loss']) and np.isfinite(r['validation_before_epoch']['loss']) for r in rs)})
+dump('training_audit.json',training)
+print(json.dumps(training,indent=2),flush=True)
