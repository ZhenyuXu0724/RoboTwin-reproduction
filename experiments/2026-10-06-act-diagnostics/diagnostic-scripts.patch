@@ -0,0 +1,50 @@
+"""Five isolated evaluation cases with bounded retries for stalled simulations."""
+from pathlib import Path
+import json, os, re, shutil, signal, subprocess, time
+root=Path('${ROBOTWIN_ROOT}')
+out=Path(__file__).parent
+script_template=(out/'eval_act_five.sh').read_text()
+trace_template=(out/'trace_eval.py').read_text()
+summary=[]
+for seed_arg in range(1,6):
+    case={'seed_argument':seed_arg,'starting_scene_seed':100000*(1+seed_arg),'attempts':[]}
+    summary.append(case)
+    for attempt in range(1,3):
+        d=out/f'case_{seed_arg}_attempt_{attempt}'
+        d.mkdir()
+        shutil.copyfile(out/'act_eval_config.yml',d/'act_eval_config.yml')
+        (d/'trace_eval.py').write_text(trace_template)
+        script=script_template.replace(str(out.relative_to(root)),str(d.relative_to(root)))
+        script=script.replace('--test_num 5 --seed 1',f'--test_num 1 --seed {seed_arg}')
+        (d/'run.sh').write_text(script)
+        print(f'START case={seed_arg} attempt={attempt}',flush=True)
+        reason=None
+        with (d/'launcher.log').open('w') as log:
+            process=subprocess.Popen(['bash',str(d/'run.sh')],cwd=root,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
+            started=time.time()
+            while process.poll() is None:
+                time.sleep(5)
+                trace=d/'object_trace.jsonl'
+                last=trace.stat().st_mtime if trace.exists() and trace.stat().st_size else started
+                limit=120 if trace.exists() and trace.stat().st_size else 240
+                if time.time()-last>limit or time.time()-started>600:
+                    reason='no_action_progress_timeout' if time.time()-last>limit else 'case_wall_time_timeout'
+                    os.killpg(process.pid,signal.SIGTERM)
+                    try: process.wait(timeout=15)
+                    except subprocess.TimeoutExpired:
+                        os.killpg(process.pid,signal.SIGKILL);process.wait()
+                    break
+        s=(d/'act_eval_client.log').read_text() if (d/'act_eval_client.log').exists() else ''
+        s=re.sub(r'\x1b\[[0-9;]*m','',s)
+        result=re.search(r'Final success rate: (\d+)/1 =',s)
+        complete=process.returncode==0 and result is not None and 'Policy rollout error' not in s
+        entry={'directory':str(d),'exit_code':process.returncode,'complete':complete,'interruption_reason':reason}
+        case['attempts'].append(entry)
+        if complete:
+            case.update(complete=True,success=bool(int(result.group(1))),result_directory=str(d))
+        print(f'END case={seed_arg} attempt={attempt} complete={complete} reason={reason}',flush=True)
+        (out/'isolated_status.json').write_text(json.dumps(summary,indent=2)+'\n')
+        if complete: break
+    case.setdefault('complete',False)
+    (out/'isolated_status.json').write_text(json.dumps(summary,indent=2)+'\n')
