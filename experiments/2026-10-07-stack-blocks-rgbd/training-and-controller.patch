@@ -0,0 +1,51 @@
+from pathlib import Path
+import json
+import numpy as np
+from PIL import Image, ImageDraw
+
+root = Path('${ROBOTWIN_ROOT}')
+out = Path(__file__).parent
+new = json.loads((out / 'results.json').read_text())
+old = json.loads((root / 'data/demo_train50/train2000_20261004_171920/evaluation/results.json').read_text())
+old_by_seed = {r['scene_seed']: r for r in old['cases']}
+rows = []
+panels = []
+for result in new['rows']:
+    if not result['complete']:
+        continue
+    seed = result['seed']
+    records = [json.loads(line) for line in (out / f'seed{seed}/trace.jsonl').read_text().splitlines()]
+    assert np.max(np.abs(np.array(result['initial_positions']) - old_by_seed[seed]['initial_positions'])) < 1e-6
+    actions = np.array([r['action'] for r in records])
+    row = {'seed': seed, 'success': result['success'], 'same_initial_positions_as_old_2000': True, 'max_lift_cm': result['max_lift_cm'], 'old_2000_max_lift_cm': [old_by_seed[seed]['red_max_height_increase_cm'], old_by_seed[seed]['green_max_height_increase_cm']], 'grasps': {}}
+    for color in ['red', 'green']:
+        side = 'right' if records[0]['before'][color][0] > 0 else 'left'
+        offset = 7 if side == 'right' else 0
+        crossings = np.where((actions[1:, offset+6] < .5) & (actions[:-1, offset+6] >= .5))[0] + 1
+        closures = []
+        for step in crossings:
+            state = records[int(step)]['before']
+            delta = (np.array(state[side + '_tcp'][:3]) - state[color]) * 100
+            closures.append({'step': int(step), 'tcp_minus_cube_xyz_cm': delta.tolist(), 'xy_error_cm': float(np.linalg.norm(delta[:2]))})
+        error = np.array([np.array(r['after']['qpos_actual'])[offset:offset+6] - np.array(r['after']['qpos_command'])[offset:offset+6] for r in records]) * 180 / np.pi
+        row['grasps'][color] = {'side': side, 'closure_threshold': .5, 'closure_crossings': closures, 'mean_absolute_joint_tracking_error_deg': float(np.abs(error).mean())}
+    rows.append(row)
+    close = row['grasps']['red']['closure_crossings']
+    first = close[0]['step'] if close else 70
+    available = sorted(int(p.name.split('_')[0]) for p in (out / f'seed{seed}/images').glob('*_cam_head.png'))
+    steps = [min(available, key=lambda t: abs(t-first)), min(available, key=lambda t: abs(t-100)), available[-1]]
+    panel = Image.new('RGB', (960, 265), 'white')
+    draw = ImageDraw.Draw(panel)
+    for j, step in enumerate(steps):
+        panel.paste(Image.open(out / f'seed{seed}/images/{step:04d}_cam_head.png'), (j*320, 25))
+        draw.text((j*320+5, 5), f'Seed {seed} | step {step}', fill='black')
+    panels.append(panel)
+if panels:
+    canvas = Image.new('RGB', (960, len(panels)*265), 'white')
+    for i, panel in enumerate(panels):
+        canvas.paste(panel, (0, i*265))
+    canvas.save(out / 'test_montage.jpg', quality=92)
+analysis = {'complete_cases': len(rows), 'rows': rows, 'measurement_note': 'Closure is the first downward crossing of the commanded gripper value through 0.5; TCP offset is measured immediately before that action, not a detector output. Lift alone is not proof of secure grasp. Same fixed scenes each evaluated once.'}
+(out / 'analysis.json').write_text(json.dumps(analysis, indent=2))
+for row in rows:
+    print(row['seed'], 'lift_cm', row['max_lift_cm'], 'success', row['success'], 'first_red_close', row['grasps']['red']['closure_crossings'][:1], 'first_green_close', row['grasps']['green']['closure_crossings'][:1])
