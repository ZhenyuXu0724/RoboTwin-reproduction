+++ b/data/demo_train50_wrist_v2/repaired_train2000_20261006_191143/run_training.py
@@ -0,0 +1,34 @@
+from pathlib import Path
+from datetime import datetime
+from zoneinfo import ZoneInfo
+import os, sys, json, subprocess
+O=Path(__file__).parent;R=Path('${ROBOTWIN_ROOT}');p=O/'experiment.json';m=json.loads(p.read_text());ckpt=Path(m['checkpoint_dir'])
+def phase(value, **extra):
+    m.update(phase=value,updated_at=datetime.now(ZoneInfo('Asia/Shanghai')).isoformat(),**extra)
+    temp=p.with_suffix('.json.tmp');temp.write_text(json.dumps(m,indent=2));temp.replace(p)
+def run(command, path, cwd):
+    with path.open('w') as log:
+        subprocess.run(command,cwd=cwd,stdout=log,stderr=subprocess.STDOUT,check=True)
+os.environ.update(CUDA_VISIBLE_DEVICES='0',TORCH_HOME=str(R/'data/model_cache/torch'),MPLCONFIGDIR='/tmp/robotwin-matplotlib',OMP_NUM_THREADS='4',MKL_NUM_THREADS='4',PYTHONUNBUFFERED='1')
+os.environ['ACT_ACTION_DIM']=subprocess.check_output(['bash',str(R/'XPolicyLab/utils/get_action_dim.sh'),str(R),'aloha_agilex'],text=True).strip()
+try:
+    assert json.loads((O/'checks/preflight.json').read_text())['status']=='passed'
+    phase('training',pipeline_pid=os.getpid())
+    run([sys.executable]+m['training_command'],ckpt/'train.log',R/'XPolicyLab/policy/ACT')
+    metrics=[json.loads(line) for line in (ckpt/'training_metrics.jsonl').read_text().splitlines()]
+    assert len(metrics)==2000 and metrics[-1]['epoch']==2000 and metrics[-1]['optimizer_steps']==80000
+    assert json.loads((ckpt/'decoder_gradient_audit.json').read_text())['all_layers_nonzero']
+    phase('checkpoint_validation',training_complete=True,training_elapsed_seconds=metrics[-1]['elapsed_seconds'],final_metrics=metrics[-1])
+    run([sys.executable,str(R/'scripts/validate_act_checkpoint.py'),'--ckpt-dir',str(ckpt),'--env-cfg-type','aloha_agilex','--action-type','joint'],O/'checkpoint_validation.log',R)
+    phase('evaluation',checkpoint_validation='passed',evaluation_completed_cases=0)
+    E=O/'evaluation50'
+    for count,seed in enumerate([200000,300000,400000,500000,600000],1):
+        run([sys.executable,'-u',str(E/'simulate.py'),'--seed',str(seed),'--steps','800','--execute-steps','50'],E/f'seed{seed}.log',R)
+        run([sys.executable,str(E/'summarize.py')],E/'summary.log',R)
+        result=json.loads((E/'results.json').read_text())
+        phase('evaluation',evaluation_completed_cases=count,evaluation_successes=result['successes'])
+    assert result['completed_cases']==5
+    run([sys.executable,str(E/'analyze_results.py')],E/'analysis.log',R)
+    phase('completed',evaluation_results=str(E/'results.json'),evaluation_completed_cases=5,evaluation_successes=result['successes'])
+except Exception as error:
+    phase('failed',failed_stage=m.get('phase'),error=str(error));raise
