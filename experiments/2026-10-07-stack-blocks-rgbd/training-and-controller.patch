+# Diagnostic: serialize camera rendering/readback while retaining the same
+# renderer, cameras, image conversion, policy and action execution.
+import numpy as np
+from envs.camera.camera import Camera
+original_get_rgba = Camera.get_rgba
+
+def serial_update_picture(self):
+    cameras = []
+    if self.collect_wrist_camera:
+        cameras.extend([('left_camera', self.left_camera), ('right_camera', self.right_camera)])
+    cameras.extend(zip(self.static_camera_name, self.static_camera_list))
+    cached = {}
+    depths = {}
+    for name, camera in cameras:
+        camera.take_picture()
+        rgba = camera.get_picture('Color')
+        depths[name] = -camera.get_picture('Position')[..., 2].copy()
+        if name != 'head_camera' or self.collect_head_camera:
+            cached[name] = {'rgba': (rgba * 255).clip(0, 255).astype('uint8')}
+    self._serial_rgba = cached
+    self._serial_depth_m = depths
+    if not getattr(self, '_serial_verified', False):
+        reference = original_get_rgba(self)
+        assert reference.keys() == cached.keys()
+        assert all(np.array_equal(reference[k]['rgba'], cached[k]['rgba']) for k in reference)
+        self._serial_verified = True
+        print('SERIAL_CAMERA_CAPTURE: cached images exactly match original RGBA getter', flush=True)
+
+def cached_get_rgba(self):
+    cached = getattr(self, '_serial_rgba', None)
+    return original_get_rgba(self) if cached is None else cached
+
+Camera.update_picture = serial_update_picture
+Camera.get_rgba = cached_get_rgba
+
