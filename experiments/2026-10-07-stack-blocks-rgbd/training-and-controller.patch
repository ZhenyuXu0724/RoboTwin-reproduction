+adapter.model.get_action=checked_get_action
+trace=(O/'trace.jsonl').open('x',buffering=1);camera_rows=(O/'cameras.jsonl').open('x',buffering=1);task_ref=None
+def vecs(task):
+    robot=task.robot
+    result={'red':task.block1.get_pose().p.tolist(),'green':task.block2.get_pose().p.tolist(),
+      'red_quaternion':task.block1.get_pose().q.tolist(),'green_quaternion':task.block2.get_pose().q.tolist(),
+      'qpos_command':list(map(float,robot.get_left_arm_jointState()+robot.get_right_arm_jointState())),
+      'qpos_actual':list(map(float,robot.get_left_arm_real_jointState()+robot.get_right_arm_real_jointState())),
+      'left_tcp':list(map(float,robot.get_left_tcp_pose())),'right_tcp':list(map(float,robot.get_right_tcp_pose()))}
+    for side in ['left','right']:
+        entity=getattr(robot,side+'_entity');active=entity.get_active_joints();qs=entity.get_qpos()
+        result[side+'_finger_actual']=[float(qs[active.index(g[0])]) for g in getattr(robot,side+'_gripper')]
+        result[side+'_finger_targets']=[float(g[0].get_drive_target()[0]) for g in getattr(robot,side+'_gripper')]
+    return result
+def snapshot(obs):
+    task=task_ref;t=int(task.take_action_cnt)
+    if t%10!=0 and t not in [49,50,59,60,69,70,79,80,89,90,99,100,199,200,209,210,219,220,229,230,239,240,249,250,259,260,269,270]:return
+    cameras=task.cameras.get_config();data={'qpos':np.array(task.robot.get_left_arm_jointState()+task.robot.get_right_arm_jointState(),dtype=np.float32)}
+    poses=vecs(task)
+    for cam,rw in [('cam_head','head_camera'),('cam_right_wrist','right_camera'),('cam_left_wrist','left_camera')]:
+        im=np.asarray(obs['vision'][cam]['color']);data[cam]=im;data[cam+'_K']=cameras[rw]['intrinsic_cv'];data[cam+'_E']=cameras[rw]['extrinsic_cv']
+        Image.fromarray(im).save(O/'images'/f'{t:04d}_{cam}.png')
+    data.update({k:np.array(v) for k,v in poses.items()});np.savez_compressed(O/'snapshots'/f'{t:04d}.npz',**data)
+    camera_rows.write(json.dumps({'step':t,**poses})+'\n')
+def fine_probe(obs):
+    import sapien
+    task=task_ref;color='red' if cli.fine<170 else 'green';actor=task.block1 if color=='red' else task.block2;original=actor.get_pose();q=np.array(task.robot.get_left_arm_jointState()+task.robot.get_right_arm_jointState())
+    side='right' if color=='red' else 'left';j=7 if side=='right' else 0;records=[]
+    def infer(view):
+        encoded=adapter.encode_obs(view,'joint',adapter.robot_action_dim_info);qn=adapter.model.pre_process(encoded['qpos'])
+        qt=torch.from_numpy(np.asarray(qn)).float().cuda()[None];im=torch.from_numpy(np.ascontiguousarray(np.stack([encoded[c] for c in adapter.camera_names]))).float().cuda()[None]
+        with torch.inference_mode():pred=adapter.model.policy(qt,im)[0].cpu().numpy()
+        return adapter.model.post_process(pred)
+    baseline=infer(obs)
+    import transforms3d as t3d
+    robot=task.robot;entity=getattr(robot,side+'_entity');joint=getattr(robot,side+'_ee');active=entity.get_active_joints();pin=entity.create_pinocchio_model();link_index=entity.get_links().index(joint.child_link);full=entity.get_qpos().copy()
+    def fk(qarm):
+        qfull=full.copy()
+        for k,aj in enumerate(getattr(robot,side+'_arm_joints')):qfull[active.index(aj)]=qarm[k]
+        pin.compute_forward_kinematics(qfull);ee_world=entity.get_root_pose()*pin.get_link_pose(link_index)*joint.get_pose_in_child()
+        rotation=t3d.quaternions.quat2mat(ee_world.q)@getattr(robot,side+'_global_trans_matrix')@getattr(robot,side+'_delta_matrix')
+        return ee_world.p+rotation@np.array([getattr(robot,side+'_gripper_bias'),0,0])
+    actual_arm=np.array(getattr(robot,'get_'+side+'_arm_real_jointState')()[:6]);fk_error=float(np.abs(fk(actual_arm)-np.array(getattr(robot,'get_'+side+'_tcp_pose')()[:3])).max());assert fk_error<1e-5,fk_error
+    baseline_tcp=np.array([fk(row[j:j+6]) for row in baseline]);closed=np.where(baseline[:,j+6]<.2)[0];closure_index=int(closed[0]) if len(closed) else int(np.argmin(baseline[:,j+6]))
+    np.savez_compressed(O/'fine_baseline.npz',pred=baseline,tcp=baseline_tcp,block=original.p,qpos=q)
+    for axis in [0,1]:
+        for shift in [-.02,-.01,.01,.02]:
