@@ -0,0 +1,77 @@
+"""Frozen-controller evaluation, one isolated simulator process per scene."""
+import collections
+import hashlib
+import json
+import re
+import shutil
+import subprocess
+import time
+from pathlib import Path
+import numpy as np
+
+ROOT = Path(__file__).resolve().parent
+REPO = Path('${ROBOTWIN_ROOT}')
+PYTHON = '${USER_HOME}/anaconda3/envs/RoboTwin/bin/python'
+manifest = json.loads((ROOT / 'manifest.json').read_text())
+rows = []
+started = time.time()
+
+def save(state, active=None):
+    complete = [r for r in rows if r['valid_rollout']]
+    successes = sum(r['success'] for r in complete)
+    data = {'status': state, 'active_seed': active, 'planned_cases': 20,
+            'finished_cases': len(rows), 'valid_cases': len(complete), 'successes': successes,
+            'success_rate': successes / len(complete) if complete else None,
+            'elapsed_seconds': time.time() - started, 'rows': rows,
+            'note': 'New fixed seeds, same frozen RGB-D controller. Errors are reported separately; official success does not assess long-term stack stability.'}
+    temp = ROOT / 'results.tmp'
+    temp.write_text(json.dumps(data, indent=2))
+    temp.replace(ROOT / 'results.json')
+
+for seed in manifest['seeds']:
+    for name, expected in manifest['file_sha256'].items():
+        assert hashlib.sha256((ROOT / name).read_bytes()).hexdigest() == expected
+    save('running', seed)
+    log_path = ROOT / f'seed{seed}.log'
+    with log_path.open('x') as output:
+        proc = subprocess.run([PYTHON, '-u', str(ROOT / 'simulate.py'), '--seed', str(seed), '--steps', '800'],
+                              cwd=REPO, stdout=output, stderr=subprocess.STDOUT)
+    text = re.sub(r'\x1b\[[0-9;]*m', '', log_path.read_text())
+    directory = ROOT / f'seed{seed}'
+    trace_file = directory / 'trace.jsonl'
+    trace = [json.loads(line) for line in trace_file.read_text().splitlines()] if trace_file.exists() else []
+    events_file = directory / 'visual_guard.jsonl'
+    events = [json.loads(line) for line in events_file.read_text().splitlines()] if events_file.exists() else []
+    actual = re.findall(r'current seed: (\d+)', text)
+    actual_seed = int(actual[-1]) if actual else None
+    success = any(frame['success'] for frame in trace)
+    valid = proc.returncode == 0 and actual_seed == seed and (success or len(trace) == 800) and 'Policy rollout error:' not in text
+    row = {'seed': seed, 'actual_seed': actual_seed, 'process_exit_code': proc.returncode,
+           'valid_rollout': valid, 'success': success, 'steps': len(trace),
+           'events': dict(collections.Counter(e.get('event', 'act_unmodified') for e in events)), 'grasps': []}
+    for event in events:
+        if event.get('event') != 'aligned_close':
+            continue
+        frame = trace[event['step']]['before']
+        cube = np.array(frame[event['phase']])
+        tcp = np.array(frame[event['side'] + '_tcp'][:3])
+        estimate = np.array(event['estimates'][event['phase']]['center'])
+        row['grasps'].append({'color': event['phase'], 'side': event['side'], 'step': event['step'],
+                              'tcp_cube_xy_error_mm': float(np.linalg.norm(tcp[:2] - cube[:2]) * 1000),
+                              'visual_center_error_mm': float(np.linalg.norm(estimate - cube) * 1000)})
+    if trace:
+        initial = np.array([trace[0]['before'][c] for c in ['red', 'green']])
+        positions = np.array([[f['after'][c] for c in ['red', 'green']] for f in trace])
+        row['max_lift_cm'] = ((positions[:, :, 2].max(axis=0) - initial[:, 2]) * 100).tolist()
+        row['final_positions'] = positions[-1].tolist()
+    paths = re.findall(r'Data has been saved to (.+)/_result.txt', text)
+    if paths:
+        video = REPO / paths[-1] / 'episode0.mp4'
+        if video.exists():
+            shutil.copy2(video, directory / 'episode.mp4')
+            row['video'] = str(directory / 'episode.mp4')
+    rows.append(row)
+    save('running')
+    print(f"{len(rows)}/20 seed={seed} valid={valid} success={success} steps={len(trace)} total_successes={sum(r['success'] for r in rows)}", flush=True)
+
