+"""Experimental calibrated RGB-D alignment guard for known colored 5 cm cubes.
+
+No actor pose or simulator ground truth is read by the controller.
+ACT still supplies the trajectory and gripper timing outside alignment events.
+"""
+import json
+import numpy as np
+import cv2
+import transforms3d as t3d
+
+
+def estimate_cube(cameras, color):
+    config=cameras.get_config();rgba=cameras.get_rgba();clouds=[];counts={}
+    for name, camera in config.items():
+        if name not in ['head_camera', 'left_camera', 'right_camera']:
+            continue
+        if name not in rgba or name not in cameras._serial_depth_m:
+            continue
+        rgb=rgba[name]['rgba'][...,:3];hsv=cv2.cvtColor(rgb,cv2.COLOR_RGB2HSV)
+        hue,sat,val=cv2.split(hsv)
+        hue_ok=((hue<12)|(hue>168)) if color=='red' else ((hue>35)&(hue<90))
+        mask=(hue_ok&(sat>130)&(val>45)).astype('uint8')
+        n,labels,stats,_=cv2.connectedComponentsWithStats(mask)
+        if n<2:continue
+        component=1+int(np.argmax(stats[1:,cv2.CC_STAT_AREA]))
+        if stats[component,cv2.CC_STAT_AREA]<20:continue
+        y,x=np.where(labels==component);z=cameras._serial_depth_m[name][y,x]
+        valid=np.isfinite(z)&(z>.1)&(z<3);y,x,z=y[valid],x[valid],z[valid]
+        if len(z)<20:continue
+        K=np.asarray(camera['intrinsic_cv']);E=np.asarray(camera['extrinsic_cv'])
+        cam=np.c_[x,y,np.ones(len(x))]@np.linalg.inv(K).T*z[:,None]
+        # extrinsic_cv maps world to CV-camera coordinates.
+        world=(cam-E[:3,3])@E[:3,:3]
+        clouds.append(world);counts[name]=len(world)
+    if not clouds:return None
+    points=np.concatenate(clouds);top=float(np.quantile(points[:,2],.98))
+    top_points=points[np.abs(points[:,2]-top)<.004]
+    if len(top_points)<20:return None
+    xy=(np.quantile(top_points[:,:2],.01,axis=0)+np.quantile(top_points[:,:2],.99,axis=0))/2
+    return {'center':np.r_[xy,top-.025], 'pixels':counts,'top_points':len(top_points)}
+
+
+class Kinematics:
+    def __init__(self,robot,side):
+        self.robot=robot;self.side=side;self.entity=getattr(robot,side+'_entity')
+        self.joint=getattr(robot,side+'_ee');self.pin=self.entity.create_pinocchio_model()
+        active=self.entity.get_active_joints()
+        self.indices=[active.index(j) for j in getattr(robot,side+'_arm_joints')]
+        self.link=self.entity.get_links().index(self.joint.child_link)
+        self.limits=np.asarray(self.entity.get_qlimits())[self.indices]
+    def pose(self,q):
+        full=self.entity.get_qpos().copy();full[self.indices]=q
+        self.pin.compute_forward_kinematics(full)
+        ee=self.entity.get_root_pose()*self.pin.get_link_pose(self.link)*self.joint.get_pose_in_child()
+        rotation=t3d.quaternions.quat2mat(ee.q)@getattr(self.robot,self.side+'_global_trans_matrix')@getattr(self.robot,self.side+'_delta_matrix')
+        position=ee.p+rotation@np.array([getattr(self.robot,self.side+'_gripper_bias'),0,0])
+        return position,rotation
+    def solve(self,q,target,rotation):
+        q=q.copy()
+        for _ in range(40):
+            p,R=self.pose(q);rot_error=rotation@R.T
+            axis,angle=t3d.axangles.mat2axangle(rot_error);orient=axis*angle
+            error=np.r_[target-p,orient*.08]
+            if np.linalg.norm(target-p)<.0015 and np.linalg.norm(orient)<.03:break
+            J=np.empty((6,len(q)))
+            for j in range(len(q)):
+                shifted=q.copy();shifted[j]+=.0001;p2,R2=self.pose(shifted)
+                axis2,angle2=t3d.axangles.mat2axangle(R2@R.T)
+                J[:,j]=np.r_[(p2-p)/.0001,axis2*angle2/.0001*.08]
+            delta=J.T@np.linalg.solve(J@J.T+np.eye(6)*.00003,error)
+            q=np.clip(q+np.clip(delta,-.12,.12),self.limits[:,0],self.limits[:,1])
+        p,R=self.pose(q)
+        return q,float(np.linalg.norm(p-target))
+
+
+class VisualGuard:
+    def __init__(self,out):
+        self.log=(out/'visual_guard.jsonl').open('x',buffering=1)
+        self.kin={};self.initial={};self.sides={};self.attempted={'red':False,'green':False}
+        self.red_lifted=False;self.red_placed=False;self.events=[]
+        self.settle=0;self.hold_action=None;self.needs_replan=False
+        self.green_lifted=False;self.green_released=False
+    def filter(self,task,action):
+        a=np.array(action,dtype=float).copy();robot=task.robot
+        estimates={color:estimate_cube(task.cameras,color) for color in ['red','green']}
+        for color,value in estimates.items():
+            if value is not None and color not in self.initial:
+                self.initial[color]=value['center'].copy();self.sides[color]='left' if value['center'][0]<0 else 'right'
+        red=estimates['red']
+        if red is not None and 'red' in self.initial:
+            p=red['center']
+            if p[2]-self.initial['red'][2]>.025:self.red_lifted=True
+            if self.red_lifted and abs(p[2]-self.initial['red'][2])<.012 and abs(p[0])<.06:
+                self.red_placed=True
+        green=estimates['green']
+        if green is not None and 'green' in self.initial:
+            if green['center'][2]-self.initial['green'][2]>.025:self.green_lifted=True
+        color='green' if self.red_placed else 'red';value=estimates[color]
+        row={'step':int(task.take_action_cnt),'phase':color,'estimates':{c:None if v is None else {'center':v['center'].tolist(),'pixels':v['pixels']} for c,v in estimates.items()},'corrected':False}
+        if self.settle:
+            self.settle-=1
+            if not self.settle:self.needs_replan=True
+            row.update(corrected=True,event='settle_closed')
+            self.log.write(json.dumps(row)+'\n')
+            return self.hold_action.copy()
+        # Before green release, align the held cube with the visually observed
+        # red cube. The cube-to-TCP offset also comes from the current images.
+        if self.green_lifted and not self.green_released:
+            side=self.sides['green'];j=0 if side=='left' else 7
+            if a[j+6]>.2:
+                a[j+6]=0
+                if red is None or green is None:
+                    row.update(corrected=True,event='release_blocked_missing_vision')
+                else:
+                    kin=self.kin[side];current=np.array(getattr(robot,'get_'+side+'_arm_real_jointState')()[:6])
+                    p,rotation=kin.pose(current);offset=p-green['center']
+                    desired_cube=red['center']+np.array([0,0,.052])
+                    error=desired_cube-green['center']
+                    if np.linalg.norm(error[:2])<.008 and abs(error[2])<.008:
+                        a[j:j+6]=current;a[j+6]=1;self.green_released=True
+                        self.settle=5;self.hold_action=a.copy()
+                        row.update(corrected=True,event='aligned_release',cube_alignment_error_cm=(error*100).tolist())
+                    else:
+                        target=desired_cube+offset
+                        if np.linalg.norm(error[:2])>.01:
+                            target[2]=max(p[2],desired_cube[2]+offset[2]+.05)
+                        q,residual=kin.solve(current,target,rotation)
+                        a[j:j+6]=q if residual<.005 else current
+                        row.update(corrected=True,event='align_before_release',ik_residual_cm=residual*100,cube_alignment_error_cm=(error*100).tolist())
+                self.log.write(json.dumps(row)+'\n')
+                return a
+        if value is not None and color in self.sides and not self.attempted[color]:
+            side=self.sides[color];j=0 if side=='left' else 7
+            if side not in self.kin:self.kin[side]=Kinematics(robot,side)
+            kin=self.kin[side];current=np.array(getattr(robot,'get_'+side+'_arm_real_jointState')()[:6])
+            current_p,_=kin.pose(current);pred_p,rotation=kin.pose(a[j:j+6]);center=value['center']
+            target=center+np.array([0,0,.0106]);distance=float(np.linalg.norm(pred_p-target))
+            # Begin alignment on low, downward approaches, before contact.
+            if current_p[2]<center[2]+.12 and pred_p[2]<center[2]+.12 and rotation[2,0]<-.9:
+                row.update(side=side,predicted_tcp_error_cm=distance*100,current_tcp_error_cm=float(np.linalg.norm(current_p-target))*100)
+                if np.linalg.norm(current_p-target)<.006:
+                    a[j:j+6]=current;a[j+6]=0;self.attempted[color]=True
+                    self.settle=5;self.hold_action=a.copy()
+                    row.update(corrected=True,event='aligned_close')
+                else:
+                    # Correct lateral error above the object before descending.
+                    safe_target=target.copy()
+                    if np.linalg.norm(current_p[:2]-target[:2])>.01:
+                        safe_target[2]=max(current_p[2],center[2]+.07)
+                    q,error=kin.solve(current,safe_target,rotation)
+                    a[j+6]=1
+                    if error<.005:
+                        a[j:j+6]=q
+                        row.update(corrected=True,event='align_open',ik_residual_cm=error*100,target=safe_target.tolist())
+                    else:
+                        a[j:j+6]=current;row.update(event='ik_failed',ik_residual_cm=error*100)
+        self.log.write(json.dumps(row)+'\n')
+        return a
