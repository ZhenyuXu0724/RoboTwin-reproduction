+"""Compare the fixed-scene baseline with RGB-D correction; truth is scoring only."""
+import json
+import re
+from pathlib import Path
+import numpy as np
+from PIL import Image, ImageDraw
+
+root = Path(__file__).resolve().parent
+baseline = json.loads((root.parent / 'evaluation50/analysis.json').read_text())
+baseline_by_seed = {r['seed']: r for r in baseline['rows']}
+rows = []
+for seed in [200000, 300000, 400000, 500000, 600000]:
+    directory = root / f'seed{seed}'
+    metadata = json.loads((directory / 'run.json').read_text())
+    assert metadata['complete']
+    trace = [json.loads(line) for line in (directory / 'trace.jsonl').read_text().splitlines()]
+    events = [json.loads(line) for line in (directory / 'visual_guard.jsonl').read_text().splitlines()]
+    grasps = []
+    for event in events:
+        if event.get('event') != 'aligned_close':
+            continue
+        frame = trace[event['step']]['before']
+        color = event['phase']
+        cube = np.array(frame[color])
+        tcp = np.array(frame[event['side'] + '_tcp'][:3])
+        estimate = np.array(event['estimates'][color]['center'])
+        grasps.append({'color': color, 'side': event['side'], 'step': event['step'],
+                       'actual_tcp_cube_xy_error_cm': float(np.linalg.norm(tcp[:2] - cube[:2]) * 100),
+                       'visual_center_error_cm': float(np.linalg.norm(estimate - cube) * 100)})
+    log = (root / f'seed{seed}.log').read_text()
+    paths = re.findall(r'Data has been saved to (.+)/_result.txt', log)
+    video = (Path.cwd() / paths[-1] / 'episode0.mp4') if paths else None
+    original = baseline_by_seed[seed]
+    first_red = original['grasps']['red']['closure_crossings'][0]
+    row = {'seed': seed, 'baseline_success': original['success'],
+           'baseline_first_red_close_xy_error_cm': first_red['xy_error_cm'],
+           'guard_success': any(frame['success'] for frame in trace), 'steps': len(trace),
+           'same_initial_positions': all(np.allclose(trace[0]['before'][color], original['initial_positions'][i], atol=1e-6) for i, color in enumerate(['red', 'green'])) if 'initial_positions' in original else None,
+           'grasps': grasps, 'release_events': [event for event in events if event.get('event') == 'aligned_release'],
+           'video': str(video) if video and video.exists() else None}
+    # Verify scene identity directly against the original rollout trace.
+    old_trace = json.loads((root.parent / f'evaluation50/seed{seed}/trace.jsonl').read_text().splitlines()[0])
+    row['same_initial_positions'] = all(np.allclose(trace[0]['before'][color], old_trace['before'][color], atol=1e-6) for color in ['red', 'green'])
+    assert row['same_initial_positions']
+    rows.append(row)
+    metadata.update(executor='original physical joint executor with experimental RGB-D action corrections and ACT cache resets',
+                    action_chunk_size=metadata.pop('num_queries', metadata.get('action_chunk_size', 50)), actual_prediction_calls=len(metadata['query_steps']),
+                    query_steps_note='ACT internal cache counters reset after alignment; these are not physical rollout steps')
+    (directory / 'run.json').write_text(json.dumps(metadata, indent=2))
+
+result = {'baseline_successes': sum(r['baseline_success'] for r in rows),
+          'guard_successes': sum(r['guard_success'] for r in rows), 'cases': len(rows), 'rows': rows,
+          'limitations': ['Five previously evaluated fixed scenes, not independent generalization evaluation.',
+                         'Adds depth, calibrated camera matrices and known color/size priors; ACT weights unchanged.',
+                         'Ground-truth cube poses used for scoring only, never by visual_guard.py.',
+                         'ACT chunk size 50 retained, with immediate cache reset after correction.']}
+(root / 'results.json').write_text(json.dumps(result, indent=2))
+montage = Image.new('RGB', (640 * 5, 240 * 2 + 30), 'white')
+draw = ImageDraw.Draw(montage)
+for i, row in enumerate(rows):
+    images = sorted((root / f"seed{row['seed']}/images").glob('*_cam_head.png'))
+    for j, image in enumerate([images[0], images[-1]]):
+        montage.paste(Image.open(image).resize((640, 240)), (i * 640, 30 + j * 240))
+    draw.text((i * 640 + 8, 8), f"seed {row['seed']}: success={row['guard_success']}", fill='black')
+montage.save(root / 'comparison.jpg')
+print(json.dumps(result, indent=2))
