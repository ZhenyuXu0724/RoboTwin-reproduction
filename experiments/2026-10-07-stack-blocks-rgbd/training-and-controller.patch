+"""Evaluate the new wrist-camera 2000-epoch checkpoint with unchanged ACT/executor in five fixed scenes."""
+from pathlib import Path
+import os,sys,json,argparse,time
+import numpy as np,torch,yaml
+from PIL import Image
+R=Path('${ROBOTWIN_ROOT}');sys.path.insert(0,str(R))
+parser=argparse.ArgumentParser();parser.add_argument('--seed',type=int,required=True);parser.add_argument('--steps',type=int,default=380)
+parser.add_argument('--fine',type=int,default=-1);parser.add_argument('--execute-steps',type=int,default=50)
+cli=parser.parse_args();assert 1<=cli.execute_steps<=50;O=Path(__file__).parent/(f'seed{cli.seed}_execute{cli.execute_steps}' if cli.execute_steps!=50 else (f'seed{cli.seed}' if cli.fine<0 else f'seed{cli.seed}_fine_fk'));O.mkdir(exist_ok=True);(O/'images').mkdir(exist_ok=True);(O/'snapshots').mkdir(exist_ok=True)
+os.environ['TORCH_HOME']=str(R/'data/model_cache/torch');os.environ['ROBOTWIN_RAY_TRACING_DENOISER']='none';os.environ['MPLCONFIGDIR']='/tmp/robotwin-matplotlib'
+torch.set_num_threads(4);torch.manual_seed(0);np.random.seed(0)
