+"""Post-run measurements and a camera montage; simulator truth used for scoring."""
+import json
+from pathlib import Path
+import numpy as np
+from PIL import Image, ImageDraw
+
+root = Path(__file__).resolve().parent
+results = json.loads((root / 'results.json').read_text())
+assert results['finished_cases'] == 20
+rows = []
+for result in results['rows']:
+    directory = root / f"seed{result['seed']}"
+    trace = [json.loads(s) for s in (directory / 'trace.jsonl').read_text().splitlines()]
+    events = [json.loads(s) for s in (directory / 'visual_guard.jsonl').read_text().splitlines()]
+    initial = trace[0]['before']
+    mode = ''.join('L' if initial[c][0] < 0 else 'R' for c in ['red', 'green'])
+    red_placed = any(e['phase'] == 'green' for e in events)
+    closed = {g['color'] for g in result['grasps']}
+    released = result['events'].get('aligned_release', 0) > 0
+    if not result['valid_rollout']:
+        stage = 'runtime_error'
+    elif result['success']:
+        stage = 'success'
+    elif 'red' not in closed:
+        stage = 'red_approach_or_detection'
+    elif not red_placed:
+        stage = 'red_grasp_or_place'
+    elif 'green' not in closed:
+        stage = 'green_approach_or_detection'
+    elif not released:
+        stage = 'green_transport_or_release_alignment'
+    else:
+        stage = 'post_release_stack'
+    red_after_green = [f['after']['red'][2] for f in trace if f['step'] >= next((g['step'] for g in result['grasps'] if g['color'] == 'green'), len(trace))]
+    row = {**result, 'initial_mode': mode, 'failure_stage_proxy': stage,
+           'red_displaced_upward_after_green_close': bool(red_after_green and max(red_after_green) - initial['red'][2] > .03)}
+    rows.append(row)
+
+errors = [g['tcp_cube_xy_error_mm'] for r in rows for g in r['grasps']]
+perception = [g['visual_center_error_mm'] for r in rows for g in r['grasps']]
+def stats(values):
+    return {'count': len(values), 'median': float(np.median(values)), 'mean': float(np.mean(values)),
+            'min': min(values), 'max': max(values)} if values else None
+by_mode = {m: {'cases': sum(r['initial_mode'] == m for r in rows),
+               'successes': sum(r['initial_mode'] == m and r['success'] for r in rows)} for m in ['LL', 'LR', 'RL', 'RR']}
+analysis = {'valid_cases': results['valid_cases'], 'successes': results['successes'], 'success_rate': results['success_rate'],
+            'grasp_xy_error_mm': stats(errors), 'visual_center_error_mm': stats(perception),
+            'mode_breakdown': by_mode, 'rows': rows,
