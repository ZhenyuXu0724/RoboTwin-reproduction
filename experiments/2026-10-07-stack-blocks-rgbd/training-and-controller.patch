+os.environ['ACT_ACTION_DIM']=str(get_action_dim('aloha_agilex'))
+cfg=yaml.safe_load((Path(__file__).parent/'act_eval_config.yml').read_text());adapter=Model(cfg)
+assert not adapter.model.temporal_agg and adapter.model.num_queries==50
