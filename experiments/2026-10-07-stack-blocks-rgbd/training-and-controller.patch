+from pathlib import Path
+import json,numpy as np,re
+R=Path('${ROBOTWIN_ROOT}');O=Path(__file__).parent;rows=[]
+for seed in [200000,300000,400000,500000,600000]:
+ d=O/f'seed{seed}';p=d/'trace.jsonl'
+ if not p.exists():continue
+ records=[json.loads(x) for x in p.read_text().splitlines() if x.strip()]
+ if not records:continue
+ run=json.loads((d/'run.json').read_text()) if (d/'run.json').exists() else None
+ obj=np.array([[r['after']['red'],r['after']['green']] for r in records]);initial=np.array([records[0]['before']['red'],records[0]['before']['green']]);lift=(obj[:,:,2]-initial[:,2])*100
+ geometry=np.all(np.abs(obj[:,1]-obj[:,0]-[0,0,.05])<[.025,.025,.012],axis=1);success=any(r['success'] for r in records)
+ if run:
+  assert run['complete'] and (len(records)==800 or success);assert run['query_steps']==list(range(0,len(records),50))
+ log=(O/f'seed{seed}.log').read_text();video=re.findall('Data has been saved to ([^\n]+)',log);video_path=str((R/Path(video[-1]).parent/'episode0.mp4').resolve()) if video else None
+ rows.append({'seed':seed,'complete':bool(run and run['complete']),'steps':len(records),'success':success,'max_lift_cm':lift.max(0).tolist(),'frames_above_3cm':(lift>3).sum(0).tolist(),'first_above_3cm':[next((i for i in range(len(records)) if lift[i,j]>3),None) for j in range(2)],'stack_geometry_ever':bool(geometry.any()),'first_stack_geometry_step':int(np.where(geometry)[0][0]) if geometry.any() else None,'final_positions':obj[-1].tolist(),'initial_positions':initial.tolist(),'video':video_path})
+result={'completed_cases':sum(r['complete'] for r in rows),'successes':sum(r['complete'] and r['success'] for r in rows),'target_cases':5,'rows':rows,'note':'Each fixed seed evaluated once. Official success requires green over red and both grippers open. Height >3 cm is a lift proxy, not proof of secure grasp.'};(O/'results.json').write_text(json.dumps(result,indent=2));print(json.dumps(result,indent=2))
