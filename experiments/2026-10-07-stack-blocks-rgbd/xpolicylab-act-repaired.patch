+import sys
+from pathlib import Path
+import unittest
+import tempfile
+import json
+from argparse import Namespace
+import torch
+from torch import nn
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from XPolicyLab.policy.ACT.losses import action_losses
+from XPolicyLab.policy.ACT.detr.models.detr_vae import DETRVAE
+from XPolicyLab.policy.ACT.detr.models.transformer import Transformer
+from XPolicyLab.policy.ACT.detr.act_policy import ACT
+
+
+class TinyBackbone(nn.Module):
+    num_channels = 32
+    def __init__(self):
+        super().__init__()
+        self.conv = nn.Conv2d(3, 32, 1)
+    def forward(self, image):
+        features = self.conv(image[:, :, :2, :2])
+        return [features], [torch.zeros_like(features[:1])]
+
+
+class RepairedTrainingTests(unittest.TestCase):
+    def test_conflicting_checkpoint_decoder_setting_fails_before_model_load(self):
+        with tempfile.TemporaryDirectory() as directory:
+            Path(directory, 'training_config.json').write_text(json.dumps(
+                {'policy_config': {'decoder_output_layer': -1}}))
+            with self.assertRaisesRegex(ValueError, 'conflicts with checkpoint'):
+                ACT({'ckpt_dir': directory, 'decoder_output_layer': 0}, Namespace())
+
+    def test_padding_does_not_dilute_valid_loss_or_add_gradients(self):
+        prediction = torch.ones(1, 4, 3, requires_grad=True)
+        target = torch.zeros_like(prediction)
+        pad = torch.tensor([[False, False, True, True]])
+        result = action_losses(prediction, target, pad)
+        self.assertEqual(result['l1'].item(), 1)
+        self.assertEqual(result['weighted_l1'].item(), 1)
+        result['weighted_l1'].backward()
+        self.assertEqual(prediction.grad[:, 2:].abs().sum().item(), 0)
+        self.assertEqual(action_losses(prediction[:, :2], target[:, :2], pad[:, :2])['l1'].item(), 1)
+
+    def test_gripper_has_four_times_per_dimension_gradient(self):
+        prediction = torch.ones(1, 1, 3, requires_grad=True)
+        result = action_losses(prediction, torch.zeros_like(prediction),
+                               torch.tensor([[False]]), [2], 4)
+        result['weighted_l1'].backward()
+        self.assertAlmostEqual((prediction.grad[0, 0, 2] / prediction.grad[0, 0, 0]).item(), 4)
+
+    def test_all_padding_produces_finite_zero_loss(self):
+        result = action_losses(torch.ones(1, 2, 3), torch.zeros(1, 2, 3),
+                               torch.ones(1, 2, dtype=torch.bool), [2], 4)
+        self.assertTrue(all(torch.isfinite(v) and v == 0 for v in result.values()))
+
+    def test_actual_forward_trains_all_decoder_layers_in_repaired_mode(self):
+        for selected, expected_nonzero in [(0, 1), (-1, 7)]:
+            with self.subTest(selected=selected):
+                torch.manual_seed(1)
+                transformer = Transformer(d_model=32, nhead=4, num_encoder_layers=1,
+                                          num_decoder_layers=7, dim_feedforward=64,
+                                          dropout=0, return_intermediate_dec=True)
+                model = DETRVAE([TinyBackbone()], transformer, None, 3, 5, ['head'], selected)
+                prediction = model(torch.randn(1, 3), torch.randn(1, 1, 3, 8, 8), None)[0]
+                self.assertEqual(tuple(prediction.shape), (1, 5, 3))
+                (prediction - torch.randn_like(prediction)).square().mean().backward()
+                nonzero = [sum(float(p.grad.abs().sum()) for p in layer.parameters()
+                               if p.grad is not None) > 0 for layer in transformer.decoder.layers]
+                self.assertEqual(sum(nonzero), expected_nonzero)
+
+
+if __name__ == '__main__':
+    unittest.main()
