+    def write_episode(self, episode_id, length=6, base=0, attrs=None):
+        time = np.arange(length, dtype=np.float32)[:, None]
+        qpos = np.concatenate([time + base, time * 2 + base + 10], axis=1)
+        action = qpos + np.array([0.5, 1.5], dtype=np.float32)
+        images = np.broadcast_to(
+            np.arange(length, dtype=np.uint8)[:, None, None, None],
+            (length, 2, 3, 3),
+        ).copy()
+        path = Path(self.dataset_dir) / f"episode_{episode_id}.hdf5"
+        with h5py.File(path, "w") as output:
+            output.create_dataset("action", data=action)
+            output.create_dataset("observations/qpos", data=qpos)
+            output.create_dataset("observations/images/cam_head", data=images)
+            for key, value in (attrs or {}).items():
+                output.attrs[key] = value
+        return qpos, action
+
+    @staticmethod
+    def identity_stats():
+        return {
+            "qpos_mean": np.zeros(2, dtype=np.float32),
+            "qpos_std": np.ones(2, dtype=np.float32),
+            "action_mean": np.zeros(2, dtype=np.float32),
+            "action_std": np.ones(2, dtype=np.float32),
+        }
+
+    def sample_episode(self, timestep):
+        with mock.patch.object(act_utils.np.random, "choice", return_value=timestep):
+            dataset = act_utils.EpisodicDataset(
+                [0], self.dataset_dir, self.CAMERA_NAMES, self.identity_stats(), 6
+            )
+            return dataset[0]
+
+    def assert_sample_alignment(self, attrs, timestep, action_start):
+        qpos, action = self.write_episode(0, attrs=attrs)
+        image, observed_qpos, observed_action, is_pad = self.sample_episode(timestep)
+        valid_length = len(action) - action_start
+        np.testing.assert_allclose(observed_qpos.numpy(), qpos[timestep])
+        np.testing.assert_allclose(image.numpy(), timestep / 255.0)
+        np.testing.assert_allclose(
+            observed_action.numpy()[:valid_length], action[action_start:]
+        )
+        np.testing.assert_array_equal(
+            is_pad.numpy(), np.arange(len(action)) >= valid_length
+        )
+
