+"""Action losses normalized over valid targets, with optional gripper weighting."""
+import math
+import torch
+
+
+def action_losses(prediction, target, is_pad, gripper_indices=(), gripper_weight=1.0):
+    if prediction.shape != target.shape or is_pad.shape != target.shape[:2]:
+        raise ValueError('Prediction, target and padding shapes do not agree')
+    indices = list(gripper_indices)
+    dim = target.shape[-1]
+    if len(set(indices)) != len(indices) or any(i < 0 or i >= dim for i in indices):
+        raise ValueError('Invalid gripper action indices')
+    if not math.isfinite(gripper_weight) or gripper_weight <= 0:
+        raise ValueError('gripper_weight must be finite and positive')
+    valid = (~is_pad).unsqueeze(-1)
+    count = valid.sum().clamp_min(1)
+    error = (prediction - target).abs() * valid
+    weights = prediction.new_ones(dim)
+    weights[indices] = gripper_weight
+    result = {'l1': error.sum() / (count * dim),
+              'weighted_l1': (error * weights).sum() / (count * weights.sum())}
+    if indices:
+        result['gripper_l1'] = error[..., indices].sum() / (count * len(indices))
+        arms = [i for i in range(dim) if i not in indices]
+        if arms:
+            result['arm_l1'] = error[..., arms].sum() / (count * len(arms))
+    return result
