+                manifest.write_text(json.dumps({"train_episode_ids": train, "validation_episode_ids": val}))
+                with self.assertRaises(ValueError):
+                    act_utils.load_data(self.dataset_dir, 3, self.CAMERA_NAMES, 1, 1, split_file=manifest)
+
+
+if __name__ == "__main__":
+    unittest.main()
